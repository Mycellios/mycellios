  "narrative": {
    "northStar": "The Computing Fabric",
    "overview": "The public page presents a single computing fabric: dark hardware joined by pale mycelium, surrounded by warm near-white space. Centered type and flat controls keep the opening direct; the large image carries the identity. A contained dark workspace explains Agent through local examples.\n\nThis records the current provisional local ReferenceLanding candidate, not user aesthetic approval or a comp-gate pass. Its resolved values apply to this landing in the Agent profile. Existing Agent and classic token scopes retain their ownership; this document does not authorize repainting the panel, studios or Agent application.",
    "keyCharacteristics": [
      "Warm near-white space, moss actions and high-contrast conceptual hardware imagery.",
      "Geist Variable for display, text and controls; native code treatment for literal endpoints.",
      "Production-kit controls, native disclosures and visible keyboard focus.",
      "An event-driven print treatment with a plain-image fallback."
    ],
    "rules": [
      {
        "name": "The Local Paint Rule",
        "body": "Keep Reference overrides on the public landing container; shared-kit ownership and the separate Agent/classic profiles remain intact.",
        "section": "colors"
      },
      {
        "name": "The Flat Action Rule",
        "body": "Actions use flat fills without decorative borders, gradients or shadows. Focus outlines and artwork shading keep their own purposes.",
        "section": "elevation"
      },
      {
        "name": "The Honest Example Rule",
        "body": "Keep concept and example labels visible; local choices, attachment text and permission responses are not live telemetry, real file access or model execution.",
        "section": "components"
      }
    ],
    "dos": [
      "Do reuse production primitives and import the same modules in Storybook.",
      "Do preserve native select, details/summary, keyboard focus and reduced-motion behavior.",
      "Do keep the connection panel in the network chapter and the artwork's fallback available.",
      "Do preserve `?landing=rooted`, `?landing=saved`, `?landing=previous` and the retained `?landing=assemblage` comparison route."
    ],
    "donts": [
      "Don't treat this provisional candidate as an approved global design replacement.",
      "Don't carry these resolved landing values into the panel, studios, Agent application or classic profile.",
      "Don't imply supported hardware, physical-network performance, live capacity, completed tasks or payouts from conceptual examples.",
      "Don't reconstruct a separate Storybook implementation or replace native controls with visual imitations."
    ]
  }
}
