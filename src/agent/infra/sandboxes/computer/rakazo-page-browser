def display_num() -> int:
    raw = os.environ.get("DISPLAY", ":1")
    try:
        return int(str(raw).lstrip(":").split(".")[0] or "1")
    except ValueError:
        return 1


def cdp_port() -> int:
    override = os.environ.get("RAKAZO_CDP_PORT")
    if override:
        return int(override)
    # rakazo-browser uses 9221 + display number (:1 -> 9222).
    return 9221 + display_num()


def http_get_json(url: str, timeout: float = 5.0) -> Any:
    with urllib.request.urlopen(url, timeout=timeout) as resp:
        data = resp.read(1024 * 1024 + 1)
        if len(data) > 1024 * 1024:
            raise RuntimeError("CDP discovery response too large")
        return json.loads(data.decode("utf-8"))


def wait_for_cdp(port: int, timeout_s: float = 3.0) -> None:
    deadline = time.time() + timeout_s
    last_error = "unreachable"
    while time.time() < deadline:
        try:
            http_get_json(f"http://127.0.0.1:{port}/json/version", timeout=1.0)
            return
        except Exception as exc:  # noqa: BLE001
            last_error = str(exc)
            time.sleep(0.25)
    raise RuntimeError(f"CDP not ready on port {port}: {last_error}")


def discover_ws_url(port: int) -> str:
    version = http_get_json(f"http://127.0.0.1:{port}/json/version")
    ws = version.get("webSocketDebuggerUrl")
    if not isinstance(ws, str) or not ws:
        raise RuntimeError("CDP version endpoint missing webSocketDebuggerUrl")
    parsed = urlsplit(ws)
    if parsed.scheme != "ws" or parsed.hostname != "127.0.0.1" or parsed.port != port:
        raise RuntimeError("Unexpected CDP endpoint")
    return ws


WORLD_NAME = "rakazo-page-browser"
# The object EVAL_HELPERS installs in that world.
PAGE_HELPER = "__" + "".join(part if i == 0 else part.title() for i, part in enumerate(WORLD_NAME.split("-")))


def page_call(method: str, *args: Any) -> str:
    """An expression calling one method of the page helper with JSON arguments."""
    return f"window.{PAGE_HELPER}.{method}({', '.join(json.dumps(arg) for arg in args)})"


# What this helper adds to the first page-tool contract. The API asks for these before it sends a
# step that an older computer image cannot run, and answers such a step itself instead.
FEATURES = ("act.press", "act.scroll", "act.hover", "act.wait", "act.dialog", "snapshot.from")

# A frame asked for, began or committed a load of another document. Same-document changes, such as
# a new URL fragment, leave the page and its fields in place and are not counted.
NAVIGATION_EVENTS = ("Page.frameRequestedNavigation", "Page.frameStartedNavigating", "Page.frameNavigated")

DIALOG_TYPES = ("alert", "confirm", "prompt", "beforeunload")
DIALOG_TEXT_LIMIT = 2000
# Answered by the browser itself, so they still work while a dialog blocks the page.
DIALOG_SAFE_METHODS = ("Page.handleJavaScriptDialog", "Target.getTargetInfo")


class Refused(RuntimeError):
    """The page helper declined an action before changing anything it does not report."""


class PageNotResponding(RuntimeError):
    """The page did not answer in time: it is busy, or shows a dialog nobody here can answer."""


class DialogOpened(BaseException):
    """The page opened a JavaScript dialog, so it answers nothing until someone answers the dialog.

    A BaseException, so the helper's best-effort ``except Exception`` paths never swallow it.
    """

    def __init__(self, dialog: dict[str, Any], typed: int | None = None, of: int | None = None) -> None:
        super().__init__(f"The page opened a {dialog.get('type')} dialog")
        self.dialog = dialog
        # For a type step: how many of its characters were typed before the dialog opened.
        self.typed = typed
        self.of = of


def dialog_info(params: dict[str, Any]) -> dict[str, Any]:
    """The bounded, untrusted description of a dialog that the model may read."""
    kind = params.get("type")
    info: dict[str, Any] = {
        "type": kind if kind in DIALOG_TYPES else "alert",
        "message": str(params.get("message") or "")[:DIALOG_TEXT_LIMIT],
    }
    if info["type"] == "prompt":
        info["defaultPrompt"] = str(params.get("defaultPrompt") or "")[:DIALOG_TEXT_LIMIT]
    return info


class CdpClient:
    def __init__(self, ws_url: str) -> None:
        self._ws_url = ws_url
        self._sock: socket.socket | None = None
        self._buf = bytearray()
        self._next_id = 1
        self.context_id: int | None = None
        self._pending: dict[int, dict[str, Any] | None] = {}
        # Worlds live in Chromium until navigation; rediscover them per CLI process.
        self._contexts: dict[int, dict[str, Any]] = {}
        # Lifecycle events reached by each frame's current document, per CDP session.
        self._lifecycle: dict[tuple[Any, str], tuple[Any, set[str]]] = {}
        # Navigations to another document started or committed in each frame, per CDP session.
        self._navigations: dict[tuple[Any, str], int] = {}
        # The JavaScript dialog open on each page session, as Chromium reported it to that session.
        self.dialogs: dict[str, dict[str, Any]] = {}

    def connect(self) -> None:
        assert self._ws_url.startswith("ws://"), self._ws_url
        rest = self._ws_url[len("ws://") :]
        host_port, _, path = rest.partition("/")
        if ":" in host_port:
            host, port_s = host_port.split(":", 1)
            port = int(port_s)
        else:
            host, port = host_port, 80
        path = "/" + path
        sock = socket.create_connection((host, port), timeout=10)
        key = base64.b64encode(os.urandom(16)).decode("ascii")
        req = (
            f"GET {path} HTTP/1.1\r\n"
            f"Host: {host_port}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n"
            "\r\n"
        )
        sock.sendall(req.encode("ascii"))
        data = b""
        while b"\r\n\r\n" not in data:
            chunk = sock.recv(4096)
            if not chunk:
                raise RuntimeError("CDP websocket handshake closed")
            data += chunk
            if len(data) > 16_384:
                raise RuntimeError("CDP handshake too large")
        header, _, leftover = data.partition(b"\r\n\r\n")
        if b"101" not in header.split(b"\r\n", 1)[0]:
            raise RuntimeError(f"CDP websocket upgrade failed: {header[:200]!r}")
        expected = base64.b64encode(
            hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode("ascii")).digest()
        )
        if expected not in header:
            raise RuntimeError("CDP websocket accept mismatch")
        self._sock = sock
        self._buf.extend(leftover)

    def close(self) -> None:
        if self._sock is not None:
            try:
                self._sock.close()
            except OSError:
                pass
            self._sock = None

    def _send_frame(self, payload: bytes) -> None:
        assert self._sock is not None
        mask = os.urandom(4)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        header = bytearray([0x81])
        n = len(payload)
        if n < 126:
            header.append(0x80 | n)
        elif n < 65536:
            header.append(0x80 | 126)
            header.extend(struct.pack("!H", n))
        else:
            header.append(0x80 | 127)
            header.extend(struct.pack("!Q", n))
        header.extend(mask)
        self._sock.sendall(header + masked)

    def _send_control(self, opcode: int, payload: bytes) -> None:
        assert self._sock is not None
        mask = os.urandom(4)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        header = bytearray([0x80 | opcode, 0x80 | len(payload)])
        header.extend(mask)
        self._sock.sendall(header + masked)

    def _read_more(self) -> None:
        assert self._sock is not None
        chunk = self._sock.recv(65536)
        if not chunk:
            raise RuntimeError("CDP websocket closed")
        self._buf.extend(chunk)

    def _read_frame(self) -> bytes:
        assert self._sock is not None
        while True:
            while len(self._buf) < 2:
                chunk = self._sock.recv(65536)
                if not chunk:
                    raise RuntimeError("CDP websocket closed")
                self._buf.extend(chunk)
            b1, b2 = self._buf[0], self._buf[1]
            opcode = b1 & 0x0F
            masked = bool(b2 & 0x80)
            length = b2 & 0x7F
            offset = 2
            if length == 126:
                while len(self._buf) < 4:
                    self._read_more()
                length = struct.unpack("!H", self._buf[2:4])[0]
                offset = 4
            elif length == 127:
                while len(self._buf) < 10:
                    self._read_more()
                length = struct.unpack("!Q", self._buf[2:10])[0]
                offset = 10
            if length > 2 * 1024 * 1024:
                raise RuntimeError("CDP frame too large")
            if not (b1 & 0x80):
                raise RuntimeError("Fragmented CDP message unsupported")
            mask = b""
            if masked:
                while len(self._buf) < offset + 4:
                    self._read_more()
                mask = bytes(self._buf[offset : offset + 4])
                offset += 4
            while len(self._buf) < offset + length:
                chunk = self._sock.recv(65536)
                if not chunk:
                    raise RuntimeError("CDP websocket closed while reading frame")
                self._buf.extend(chunk)
            payload = bytes(self._buf[offset : offset + length])
            del self._buf[: offset + length]
            if masked:
                payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
            if opcode == 0x8:
                raise RuntimeError("CDP websocket closed by peer")
            if opcode == 0x9:
                self._send_control(0xA, payload)
                continue
            if opcode in (0x1, 0x2, 0x0):
                return payload

    def _handle_event(self, message: dict[str, Any]) -> None:
        method = message.get("method")
        params = message.get("params") or {}
        session_id = message.get("sessionId")
        if method == "Runtime.executionContextCreated":
            context = params.get("context")
            if not isinstance(context, dict):
                return
            context_id = context.get("id")
            if not isinstance(context_id, int):
                return
            recorded = dict(context)
            recorded["_sessionId"] = session_id
            self._contexts[context_id] = recorded
        elif method == "Runtime.executionContextDestroyed":
            context_id = params.get("executionContextId")
            if isinstance(context_id, int):
                self._contexts.pop(context_id, None)
        elif method == "Page.lifecycleEvent":
            frame_id, name = params.get("frameId"), params.get("name")
            if not isinstance(frame_id, str) or not isinstance(name, str):
                return
            loader_id, reached = self._lifecycle.get((session_id, frame_id), (None, set()))
            if name == "init" or params.get("loaderId") != loader_id:
                loader_id, reached = params.get("loaderId"), set()
            reached.add(name)
            self._lifecycle[(session_id, frame_id)] = (loader_id, reached)
        elif method in NAVIGATION_EVENTS:
            frame_id = params.get("frameId") or (params.get("frame") or {}).get("id")
            if not isinstance(frame_id, str) or params.get("disposition", "currentTab") != "currentTab":
                return
            if params.get("navigationType") in ("sameDocument", "historySameDocument"):
                return
            self._navigations[(session_id, frame_id)] = self._navigations.get((session_id, frame_id), 0) + 1
        elif method == "Page.javascriptDialogOpening":
            if isinstance(session_id, str):
                self.dialogs[session_id] = dialog_info(params)
        elif method == "Page.javascriptDialogClosed":
            if isinstance(session_id, str):
                self.dialogs.pop(session_id, None)
        elif method == "Runtime.executionContextsCleared":
            if session_id is None:
                self._contexts.clear()
            else:
                self._contexts = {
                    cid: ctx
                    for cid, ctx in self._contexts.items()
                    if ctx.get("_sessionId") != session_id
                }

    def lifecycle(self, session_id: str, frame_id: str) -> set[str]:
        return self._lifecycle.get((session_id, frame_id), (None, set()))[1]

    def navigations(self, session_id: str, frame_id: str) -> int:
        return self._navigations.get((session_id, frame_id), 0)

    def find_world_context(self, world_name: str, frame_id: str, session_id: str) -> int | None:
        for context_id, context in self._contexts.items():
            if context.get("name") != world_name:
                continue
            if context.get("_sessionId") != session_id:
                continue
            aux = context.get("auxData") or {}
            if not isinstance(aux, dict) or aux.get("frameId") != frame_id or aux.get("isDefault") is not False:
                continue
            return context_id
        return None

    def send(self, method: str, params: dict[str, Any] | None = None, *, session_id: str | None = None) -> int:
        """Send a command without waiting for its answer, which is dropped when it arrives."""
        assert self._sock is not None
        msg_id = self._next_id
        self._next_id += 1
        payload: dict[str, Any] = {"id": msg_id, "method": method, "params": params or {}}
        if session_id:
            payload["sessionId"] = session_id
        self._send_frame(json.dumps(payload).encode("utf-8"))
        return msg_id

    def _check_dialog(self, method: str, session_id: str | None, msg_id: int | None = None) -> None:
        # A page showing a dialog answers nothing else until the dialog closes: stop waiting on it.
        if session_id and session_id in self.dialogs and method not in DIALOG_SAFE_METHODS:
            if msg_id is not None:
                self._pending.pop(msg_id, None)
            raise DialogOpened(self.dialogs[session_id])

    def call(
        self,
        method: str,
        params: dict[str, Any] | None = None,
        *,
        session_id: str | None = None,
        timeout_s: float = 30.0,
    ) -> dict[str, Any]:
        assert self._sock is not None
        self._check_dialog(method, session_id)
        msg_id = self._next_id
        self._pending[msg_id] = None
        self.send(method, params, session_id=session_id)
        deadline = time.time() + timeout_s
        while time.time() < deadline:
            pending = self._pending.get(msg_id)
            if pending is not None:
                self._pending.pop(msg_id, None)
                if "error" in pending:
                    raise RuntimeError(f"{method} failed: {pending['error']}")
                result = pending.get("result")
                return result if isinstance(result, dict) else {}
            self._sock.settimeout(max(0.1, deadline - time.time()))
            try:
                frame = self._read_frame()
            except socket.timeout:
                continue
            message = json.loads(frame.decode("utf-8"))
            if not isinstance(message, dict):
                continue
            if message.get("id") in self._pending:
                self._pending[int(message["id"])] = message
                continue
            if message.get("method"):
                self._handle_event(message)
                self._check_dialog(method, session_id, msg_id)
        self._pending.pop(msg_id, None)
        raise TimeoutError(f"CDP call timed out: {method}")


def attach_page(client: CdpClient) -> str:
    targets = client.call("Target.getTargets").get("targetInfos") or []
    pages = [t for t in targets if isinstance(t, dict) and t.get("type") == "page"]
    candidates = []
    silent = 0
    for page in pages[:32]:
        attached = client.call("Target.attachToTarget", {
            "targetId": page["targetId"], "flatten": True,
        })
        session_id = attached["sessionId"]
        try:
            client.call("Page.enable", session_id=session_id, timeout_s=PAGE_ANSWER_SECONDS)
            ensure_world(client, session_id)
            if eval_json(client, session_id, 'document.visibilityState === "visible"'):
                focused = eval_json(client, session_id, "document.hasFocus()")
                candidates.append((session_id, focused))
        except TimeoutError:
            silent += 1
        except (Exception, DialogOpened):
            continue
    focused = [session for session, focus in candidates if focus]
    if len(focused) == 1:
        selected = focused[0]
    elif len(candidates) == 1:
        selected = candidates[0][0]
    elif not candidates and silent:
        raise PageNotResponding()
    else:
        raise RuntimeError("No unambiguous visible browser tab. Use desktop tools to select a tab.")
    ensure_world(client, selected)
    return selected


def scoped_target(client: CdpClient, mapping: Path, create: bool) -> str | None:
    """Reuse only the conversation's target. Never infer ownership from focus or URL."""
    try:
        with os.fdopen(os.open(mapping, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), "r") as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                raise RuntimeError("Invalid browser tab mapping")
            saved = stream.read(65).strip()
    except FileNotFoundError:
        saved = ""
    if re.fullmatch(r"[a-fA-F0-9]{32}", saved):
        targets = client.call("Target.getTargets").get("targetInfos") or []
        if any(t.get("type") == "page" and t.get("targetId") == saved for t in targets):
            return saved
    if not create:
        return None
    target = client.call("Target.createTarget", {"url": "about:blank", "background": True})["targetId"]
    if not re.fullmatch(r"[a-fA-F0-9]{32}", target):
        raise RuntimeError("Chromium returned an invalid browser tab")
    with tempfile.NamedTemporaryFile(mode="w", dir=mapping.parent, delete=False) as stream:
        temp = stream.name
        stream.write(target)
    try:
        os.replace(temp, mapping)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)
    return target


def scope_directory(port: int) -> Path:
    directory = Path(f"/tmp/mycellios-browser-{os.getuid()}-{port}")
    directory.mkdir(mode=0o700, exist_ok=True)
    info = directory.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise RuntimeError("Browser tab storage is not private")
    return directory


# A page that does not answer within this time is busy, or blocked by a dialog nobody here can answer.
PAGE_ANSWER_SECONDS = 5.0


def run_scoped(client: CdpClient, port: int, command: str, args: dict[str, Any]) -> dict[str, Any]:
    import fcntl

    key = args.get("conversationKey")
    if not isinstance(key, str) or not re.fullmatch(r"[a-f0-9]{64}", key):
        raise RuntimeError("Invalid browser conversation scope")
    directory = scope_directory(port)
    # Activation and real keyboard input share a display. Serialize a whole
    # command, including target selection, so input cannot leak to another tab.
    lock_fd = os.open(directory / "display.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    with os.fdopen(lock_fd, "r+") as lock:
        if not stat.S_ISREG(os.fstat(lock.fileno()).st_mode):
            raise RuntimeError("Invalid browser display lock")
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        return run_in_tab(client, directory, key, command, args)


def run_in_tab(client: CdpClient, directory: Path, key: str, command: str, args: dict[str, Any]) -> dict[str, Any]:
    """Run one command in the conversation's own tab, under the display lock."""
    target = scoped_target(client, directory / key, create=command == "navigate")
    if target is None:
        if command == "snapshot":
            return {"ok": True, "url": "about:blank", "title": "", "tree": "", "elements": []}
        return {"ok": False, "completed": 0, "uncertain": False,
                "error": "Open a page in this conversation first."}
    keeper = dialog_socket(directory, key)
    held = held_dialog(keeper)
    steps = args.get("actions")
    answer = None
    if held is not None and command == "act" and isinstance(steps, list) and steps \
            and isinstance(steps[0], dict) and steps[0].get("kind") == "dialog":
        validate_actions(steps)
        answer = steps[0]
    elif held is not None and command != "focus":
        return held_dialog_refusal(client, target, held, command)
    if command != "snapshot":
        client.call("Target.activateTarget", {"targetId": target})
    if command == "focus":
        return {"ok": True}
    session_id = client.call("Target.attachToTarget", {"targetId": target, "flatten": True})["sessionId"]
    done_before = 0
    if answer is not None:
        refused = answer_held_dialog(client, session_id, keeper, answer)
        if refused is not None:
            return refused
        args = {**args, "actions": steps[1:]}
        done_before = 1
    try:
        try:
            client.call("Page.enable", session_id=session_id, timeout_s=PAGE_ANSWER_SECONDS)
        except TimeoutError:
            return not_responding(command, done_before)
        ensure_world(client, session_id)
        result = run_page_command(client, session_id, command, args, done_before)
    except DialogOpened as opened:
        total = done_before + len(args.get("actions") or []) if command == "act" else None
        result = dialog_result(client, session_id, opened.dialog,
                               f"The page opened {dialog_name(opened.dialog)}.",
                               done_before if command == "act" else None, total)
    if "dialog" in result:
        # Only a dialog that a Mico command led to is the Mico's to answer.
        held_now = command in ("navigate", "act") and session_id in client.dialogs \
            and hold_dialog(client, session_id, keeper, client.dialogs[session_id])
        settle_dialog(result, held_now)
    return result


def run_page_command(client: CdpClient, session_id: str, command: str, args: dict[str, Any],
                     done_before: int = 0) -> dict[str, Any]:
    try:
        if command == "navigate":
            return navigate(client, session_id, str(args.get("url") or ""))
        if command == "snapshot":
            return snapshot(client, session_id, snapshot_part(args.get("from")))
        actions = args.get("actions")
        if not isinstance(actions, list):
            raise RuntimeError("actions must be an array")
        return act(client, session_id, actions, done_before)
    except DialogOpened as opened:
        reading = " while the page was being read" if command == "snapshot" else ""
        return dialog_result(client, session_id, opened.dialog,
                             f"The page opened {dialog_name(opened.dialog)}{reading}.",
                             done_before if command == "act" else None)
    except Refused as refused:
        if command != "snapshot":
            raise
        # A part of a snapshot that no longer exists: settled, and fixed by a new snapshot.
        return {"ok": False, "uncertain": False, "error": str(refused)}


def snapshot_part(value: Any) -> int:
    if value is None:
        return 0
    if isinstance(value, bool) or not isinstance(value, int) or not 0 <= value < SNAPSHOT_PARTS:
        raise RuntimeError(f"from must be a part number from 0 to {SNAPSHOT_PARTS - 1}")
    return value


def not_responding(command: str, done_before: int) -> dict[str, Any]:
    result: dict[str, Any] = {
        "ok": False, "uncertain": False,
        "error": "This page is not responding. It may be showing a dialog that only a person can answer "
                 "(use request_takeover), or it is still busy: take a snapshot again in a moment.",
    }
    if command == "act":
        result["completed"] = done_before
    return result


def dialog_name(dialog: dict[str, Any]) -> str:
    kind = str(dialog.get("type") or "")
    return f"a {kind} dialog" if kind != "alert" else "an alert dialog"


def page_of(client: CdpClient, *, session_id: str | None = None, target: str | None = None) -> dict[str, str]:
    """The tab's URL and title as the browser knows them, which still works while a dialog is open."""
    try:
        info = client.call("Target.getTargetInfo", {"targetId": target} if target else {},
                           session_id=session_id, timeout_s=PAGE_ANSWER_SECONDS).get("targetInfo") or {}
    except Exception:  # noqa: BLE001
        info = {}
    return {"url": str(info.get("url") or "")[:2048], "title": str(info.get("title") or "")[:200]}


def dialog_result(client: CdpClient, session_id: str, dialog: dict[str, Any], error: str,
                  completed: int | None = None, total: int | None = None) -> dict[str, Any]:
    result: dict[str, Any] = {"ok": False, "uncertain": False, **page_of(client, session_id=session_id),
                              "dialog": dict(dialog), "error": error}
    if completed is not None:
        result["completed"] = completed
        if total is not None and total > completed:
            result["error"] += f" The remaining {total - completed} step(s) did not run."
    return result


def settle_dialog(result: dict[str, Any], held: bool) -> dict[str, Any]:
    """Say who can answer the dialog in result: the Mico's next step, or only a person."""
    if held:
        result["error"] += (" Read its message, then answer it with a browser_act dialog step: accept, or"
                            " dismiss (text answers a prompt). Nothing else runs on this page until then.")
    else:
        result["dialog"] = {**result["dialog"], "forPerson": True}
        result["error"] += " It stays for a person to answer: use request_takeover if you need this page."
    return result


def held_dialog_refusal(client: CdpClient, target: str, dialog: dict[str, Any], command: str) -> dict[str, Any]:
    result: dict[str, Any] = {
        "ok": False, "uncertain": False, **page_of(client, target=target), "dialog": dict(dialog),
        "error": f"{dialog_name(dialog).capitalize()} from your earlier step is still open on this page."
                 " Answer it first with a browser_act dialog step: accept, or dismiss (text answers a prompt).",
    }
    if command == "act":
        result["completed"] = 0
    return result


# The dialog keeper. Chromium lets only a CDP session that was listening when a dialog opened answer
# it, and a later session cannot even read the page until the dialog closes. So the command that saw
# a dialog leaves its connection to a small process that holds the dialog for the conversation's next
# command, which asks it over a Unix socket in the private tab directory.
DIALOG_HOLD_SECONDS = 600.0
DIALOG_ASK_SECONDS = 2.0
DIALOG_ANSWER_SECONDS = 8.0
DIALOG_LINE_BYTES = 64 * 1024


def dialog_socket(directory: Path, key: str) -> Path:
    # Unix socket paths are short; half of the key still names one conversation.
    return directory / f"{key[:32]}.dialog"


def send_line(conn: socket.socket, message: dict[str, Any]) -> None:
    conn.sendall(json.dumps(message).encode("utf-8") + b"\n")


def read_line(conn: socket.socket) -> dict[str, Any]:
    data = bytearray()
    while not data.endswith(b"\n"):
        chunk = conn.recv(4096)
        if not chunk:
            break
        data += chunk
        if len(data) > DIALOG_LINE_BYTES:
            raise ValueError("Dialog message too large")
    message = json.loads(data.decode("utf-8"))
    if not isinstance(message, dict):
        raise ValueError("Invalid dialog message")
    return message


def ask_dialog_keeper(path: Path, request: dict[str, Any], timeout_s: float = DIALOG_ASK_SECONDS) -> dict[str, Any] | None:
    """The keeper's reply, or None when no keeper holds a dialog for this conversation."""
    family = getattr(socket, "AF_UNIX", None)
    if family is None:
        return None
    with socket.socket(family, socket.SOCK_STREAM) as conn:
        conn.settimeout(timeout_s)
        try:
            conn.connect(str(path))
        except OSError:
            return None
        send_line(conn, request)
        return read_line(conn)


def held_dialog(path: Path) -> dict[str, Any] | None:
    """The dialog a keeper holds for this conversation. A keeper that does not answer holds none."""
    try:
        reply = ask_dialog_keeper(path, {"op": "describe"})
    except (OSError, ValueError):
        return None
    dialog = reply.get("dialog") if reply and reply.get("ok") is True else None
    return dialog if isinstance(dialog, dict) else None


def answer_held_dialog(client: CdpClient, session_id: str, path: Path, step: dict[str, Any]) -> dict[str, Any] | None:
    """Answer the held dialog with a dialog step. None once it is answered, else the call's result."""
    # Listen on this session before the dialog closes, so a dialog the page opens right after the
    # answer reaches this command. The browser enables it before it answers the next call here.
    client.send("Page.enable", session_id=session_id)
    client.call("Target.getTargets")
    request: dict[str, Any] = {"op": "answer", "accept": step.get("accept") is True}
    if isinstance(step.get("text"), str):
        request["promptText"] = step["text"]
    try:
        reply = ask_dialog_keeper(path, request, DIALOG_ANSWER_SECONDS)
    except (OSError, ValueError):
        return {"ok": False, "completed": 0, "uncertain": True, "fallback": "computer_act",
                "error": "The dialog answer was sent, but its result was lost. Look at the page before continuing."}
    if reply is None or reply.get("error") == "closed":
        return {"ok": False, "completed": 0, "uncertain": False,
                "error": "That dialog is no longer waiting for your answer: it closed, or only a person can answer"
                         " it now. Take a snapshot to see the page."}
    if reply.get("ok") is not True:
        return {"ok": False, "completed": 0, "uncertain": True, "fallback": "computer_act",
                "error": "The dialog could not be answered. Look at the page before continuing."}
    return None


def hold_dialog(client: CdpClient, session_id: str, path: Path, dialog: dict[str, Any]) -> bool:
    """Leave this connection, with the dialog open on it, to a keeper the next command can ask."""
    if getattr(socket, "AF_UNIX", None) is None or client._sock is None:
        return False
    fd = client._sock.fileno()
    init = {"session": session_id, "path": str(path), "dialog": dialog, "nextId": client._next_id + 1_000_000,
            # Bytes Chromium already sent that this process read but did not handle.
            "pending": base64.b64encode(bytes(client._buf)).decode("ascii")}
    try:
        keeper = subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "hold-dialog", str(fd)],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            pass_fds=(fd,), start_new_session=True)
    except OSError:
        return False
    assert keeper.stdin is not None and keeper.stdout is not None
    try:
        keeper.stdin.write(json.dumps(init).encode("utf-8") + b"\n")
        keeper.stdin.close()
        if select.select([keeper.stdout], [], [], 3.0)[0] and keeper.stdout.readline(16) == b"ready\n":
            return True
    except OSError:
        pass
    finally:
        keeper.stdout.close()
    keeper.kill()
    return False


def keep_dialog(fd: int) -> int:
    """Hold one page dialog for the conversation's next command, for a bounded time."""
    init = json.loads(sys.stdin.buffer.readline(DIALOG_LINE_BYTES).decode("utf-8"))
    session, path = str(init["session"]), str(init["path"])
    sock = socket.socket(fileno=fd)
    # The descriptor keeps the non-blocking mode of the command that passed it on.
    sock.settimeout(1.0)
    client = CdpClient("ws://127.0.0.1/dialog")
    client._sock = sock
    client._buf.extend(base64.b64decode(init["pending"]))
    client._next_id = int(init["nextId"])
    client.dialogs[session] = dict(init["dialog"])
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    previous = os.umask(0o177)
    try:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(path)
        listener.bind(path)
    finally:
        os.umask(previous)
    listener.listen(4)
    own = os.stat(path).st_ino
    sys.stdout.write("ready\n")
    sys.stdout.flush()
    os.dup2(os.open(os.devnull, os.O_RDWR), 1)
    try:
        hold_until_answered(client, session, listener, path, own, time.monotonic() + DIALOG_HOLD_SECONDS)
    finally:
        release_dialog_socket(path, own)
        listener.close()
        sock.close()
    return 0


def hold_until_answered(client: CdpClient, session: str, listener: socket.socket, path: str, own: int,
                        deadline: float) -> None:
    """Serve the conversation's commands until the dialog is answered or closes, or time is up.

    When the keeper stops, its connection closes and the browser keeps any dialog still open for a
    person to answer.
    """
    assert client._sock is not None
    while session in client.dialogs and time.monotonic() < deadline:
        waiting = [listener] + ([] if client._buf else [client._sock])
        pause = 0.0 if client._buf else max(0.0, min(1.0, deadline - time.monotonic()))
        readable = select.select(waiting, [], [], pause)[0]
        if (client._buf or client._sock in readable) and not pump_dialog_events(client, session):
            return
        if listener in readable and serve_dialog_request(client, session, listener, path, own):
            return


def pump_dialog_events(client: CdpClient, session: str) -> bool:
    """Handle one CDP message; False once the browser or the tab is gone."""
    assert client._sock is not None
    client._sock.settimeout(1.0)
    try:
        frame = client._read_frame()
    except socket.timeout:
        return True  # The rest of a message arrives later; what was read stays buffered.
    except (OSError, RuntimeError):
        return False
    try:
        message = json.loads(frame.decode("utf-8"))
    except ValueError:
        return True
    if isinstance(message, dict) and message.get("method"):
        client._handle_event(message)
        params = message.get("params") or {}
        if message["method"] == "Target.detachedFromTarget" and params.get("sessionId") == session:
            return False
    return True


def serve_dialog_request(client: CdpClient, session: str, listener: socket.socket, path: str, own: int) -> bool:
    """Answer one request from a command of this conversation; True once the dialog is answered."""
    conn, _ = listener.accept()
    with conn:
        conn.settimeout(DIALOG_ASK_SECONDS)
        try:
            request = read_line(conn)
        except (OSError, ValueError):
            return False
        if request.get("op") == "describe":
            send_line(conn, {"ok": True, "dialog": client.dialogs.get(session)})
            return False
        if request.get("op") != "answer" or not isinstance(request.get("accept"), bool):
            send_line(conn, {"ok": False, "error": "invalid"})
            return False
        # A dialog the page opens next is held by a new keeper under the same name.
        release_dialog_socket(path, own)
        params: dict[str, Any] = {"accept": request["accept"]}
        if isinstance(request.get("promptText"), str):
            params["promptText"] = request["promptText"][:DIALOG_LINE_BYTES // 2]
        try:
            client.call("Page.handleJavaScriptDialog", params, session_id=session, timeout_s=5.0)
            reply: dict[str, Any] = {"ok": True}
        except (OSError, RuntimeError, TimeoutError) as exc:
            reply = {"ok": False, "error": "closed" if "No dialog is showing" in str(exc) else "failed"}
        with contextlib.suppress(OSError):
            send_line(conn, reply)
        return True


def release_dialog_socket(path: str, own: int) -> None:
    with contextlib.suppress(OSError):
        if os.stat(path).st_ino == own:
            os.unlink(path)


def ensure_world(client: CdpClient, session_id: str) -> None:
    # Rediscover only an isolated context bound to this frame and CDP session.
    # Never run helpers in a page-owned default context with the same name.
    frame = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]
    frame_id = frame["id"]
    client.call("Runtime.enable", session_id=session_id)
    existing = client.find_world_context(WORLD_NAME, frame_id, session_id)
    if existing is not None:
        client.context_id = existing
        return
    world = client.call("Page.createIsolatedWorld", {
        "frameId": frame_id, "worldName": WORLD_NAME,
    }, session_id=session_id)
    client.context_id = world["executionContextId"]


