          refs.set(el, ref);
          refMap.set(ref, el);
        }
        elements.push({
          ref,
          role: roleOf(el),
          name: String(nameOf(el)).slice(0, 200),
          value: el.type === "password" || loginFilled.has(el) ? undefined
            : isFileInput(el) ? Array.from(el.files || [], (file) => file.name).join(", ")
            : ["checkbox", "radio"].includes(el.type) ? (el.checked ? "checked" : "unchecked")
            : "value" in el ? String(el.value ?? "").slice(0, 2000) : undefined,
          tag: el.tagName.toLowerCase(),
        });
      }
      const more = part + 1 < parts;
      return {
        url: location.href,
        title: (document.title || "").slice(0, 200),
        elements,
        tree: text.slice(part * PART_TEXT, (part + 1) * PART_TEXT) + "\n" + formatTree(elements)
          + (!part && document.querySelector("iframe,frame") ? "\nEmbedded frames require desktop tools." : "")
          + (more ? `\n(Part ${part + 1} of ${parts}. Call browser_snapshot with from: ${part + 1} to read on.)` : ""),
        ...(more ? { next: part + 1 } : {}),
      };
    },
    busy() {
      return loadingShown();
    },
    // Whether a wait step's condition holds now. Text matches ignore case and runs of spaces.
    waitState(until, text) {
      if (until === "quiet") return quietFor() >= 500 && document.readyState === "complete" && !loadingShown();
      const found = plain(document.body?.innerText || "").includes(plain(text));
      return until === "gone" ? !found : found;
    },
    // Focuses an element so the next pressed key goes to it.
    focusRef(ref) {
      const el = this.resolve(ref);
      if (!el) throw new Error(`Unknown element ref: ${ref}`);
      el.focus();
      const active = document.activeElement;
      return Boolean(active) && (active === el || el.contains(active));
    },
    // Scrolls an element into view, or by most of a screen what a wheel over the element (or over
    // the middle of the window) would move: its own scroll area, else the page.
    scroll(ref, direction) {
      const el = ref ? this.resolve(ref) : null;
      if (ref && !el) throw new Error(`Unknown element ref: ${ref}`);
      if (!direction) {
        el.scrollIntoView({ block: "center", inline: "nearest", behavior: "instant" });
        return { scrolled: true };
      }
      const vertical = direction === "up" || direction === "down";
      const sign = direction === "up" || direction === "left" ? -1 : 1;
      const page = document.scrollingElement || document.documentElement;
      let area = el || document.elementFromPoint(window.innerWidth / 2, window.innerHeight / 2);
      while (area && area !== page && !canScroll(area, vertical, sign)) area = area.parentElement;
      area = area || page;
      const size = area === page ? (vertical ? window.innerHeight : window.innerWidth)
        : (vertical ? area.clientHeight : area.clientWidth);
      const before = vertical ? area.scrollTop : area.scrollLeft;
      area.scrollBy({ [vertical ? "top" : "left"]: sign * Math.max(40, Math.round(size * 0.85)), behavior: "instant" });
      return { scrolled: (vertical ? area.scrollTop : area.scrollLeft) !== before };
    },
    // Where the pointer goes to hover an element: its middle, once in view, unless something covers it.
    hoverPoint(ref) {
      const el = this.resolve(ref);
      if (!el) throw new Error(`Unknown element ref: ${ref}`);
      let rect = el.getBoundingClientRect();
      if (rect.top < 0 || rect.left < 0 || rect.bottom > window.innerHeight || rect.right > window.innerWidth) {
        el.scrollIntoView({ block: "center", inline: "center", behavior: "instant" });
        rect = el.getBoundingClientRect();
      }
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const hit = document.elementFromPoint(x, y);
      if (!hit || !(hit === el || el.contains(hit))) {
        throw refused("Another element covers this one, so it was not hovered. Close what covers it, or take a fresh snapshot.");
      }
