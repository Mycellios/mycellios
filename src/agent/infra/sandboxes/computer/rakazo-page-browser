      return letters(shown) === letters(text);
    },
  };
  return true;
})()
"""


def eval_json(client: CdpClient, session_id: str, expression: str, timeout_s: float = 30.0) -> Any:
    result = client.call(
        "Runtime.evaluate",
        {
            "expression": expression,
            "contextId": client.context_id,
            "returnByValue": True,
            "awaitPromise": True,
        },
        session_id=session_id,
        timeout_s=timeout_s,
    )
    if result.get("exceptionDetails"):
        details = result["exceptionDetails"]
        # Chromium's text is just "Uncaught"; the reason is the thrown error's first line.
        description = str((details.get("exception") or {}).get("description") or "").split("\n")[0]
        text = description.removeprefix("Error: ") or details.get("text") or "evaluate failed"
        if text.startswith("Refused: "):
            raise Refused(text.removeprefix("Refused: "))
        raise RuntimeError(str(text))
    return (result.get("result") or {}).get("value")


def ensure_helpers(client: CdpClient, session_id: str) -> None:
    ensure_world(client, session_id)
    eval_json(client, session_id, EVAL_HELPERS)


def navigate(client: CdpClient, session_id: str, url: str) -> dict[str, Any]:
    parsed = urlsplit(url)
    if parsed.scheme not in ("http", "https") or parsed.username or parsed.password:
        raise RuntimeError("Only HTTP(S) URLs without embedded credentials are supported")
    result = client.call("Page.navigate", {"url": url}, session_id=session_id, timeout_s=15.0)
    if result.get("errorText") or result.get("isDownload"):
        raise RuntimeError(result.get("errorText") or "Navigation started a download")
    deadline = time.monotonic() + 10.0
    page: dict[str, Any] | None = None
    while page is None and time.monotonic() < deadline:
        try:
            frame = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]
            if result.get("loaderId") and frame.get("loaderId") != result["loaderId"]:
                time.sleep(0.1)
                continue
            ensure_world(client, session_id)
            ready = eval_json(client, session_id, "document.readyState")
            if ready in ("interactive", "complete"):
                page = {"ok": True, "url": eval_json(client, session_id, "location.href"),
                        "title": eval_json(client, session_id, "(document.title || '').slice(0, 200)")}
                break
        except Exception:
            pass
        time.sleep(0.1)
    if page is None:
        raise RuntimeError("Navigation did not settle; inspect the screen before continuing")
    # The first snapshot comes with the page, which saves the model a call. Without it, the caller
    # takes the snapshot itself.
    with contextlib.suppress(Exception):
        page.update(snapshot(client, session_id))
    return page


MAX_UPLOAD_FILES = 10
MAX_UPLOAD_BYTES = 100 * 1024 * 1024


def resolve_upload_paths(
    paths: Any, home: str | None = None, roots: list[str] | None = None,
) -> list[str]:
    """Resolve regular files within trusted roots before handing them to Chromium."""
    if not isinstance(paths, list) or not 1 <= len(paths) <= MAX_UPLOAD_FILES:
        raise RuntimeError(f"upload needs 1 to {MAX_UPLOAD_FILES} file paths")
    home = os.path.realpath(home or os.environ.get("HOME") or "/home/rakazo")
    location = "your folder or shared/" if roots is not None else "this computer's home folder"
    allowed = [home]
    if roots is not None:
        allowed = []
        for root in roots:
            expected = os.path.normpath(os.path.join(home, root))
            full = os.path.realpath(expected)
            # A root redirected by a symlink (bots/b1 -> bots/b2) could reach another bot's files.
            if os.path.isabs(root) or full != expected or os.path.commonpath([home, full]) != home:
                raise RuntimeError(f"Upload files must be inside {location}")
            # A folder that does not exist yet holds no files; the other root still applies.
            if os.path.isdir(full):
                allowed.append(full)
    max_bytes = MAX_UPLOAD_BYTES
    override = os.environ.get("RAKAZO_BROWSER_UPLOAD_MAX_BYTES", "")
    try:
        if int(override) > 0:
            max_bytes = int(override)
    except ValueError:
        pass
    resolved = []
    total = 0
    for path in paths:
        if not isinstance(path, str) or not path.strip():
            raise RuntimeError("upload paths must be non-empty strings")
        full = os.path.realpath(os.path.join(home, path))
        # Check confinement before existence to avoid revealing outside targets.
        if not any(os.path.commonpath([root, full]) == root for root in allowed):
            raise RuntimeError(f"Upload files must be inside {location}: {path}")
        try:
            info = os.stat(full)
        except OSError:
            raise RuntimeError(f"File not found: {path}") from None
        if not stat.S_ISREG(info.st_mode):
            raise RuntimeError(f"Not a regular file: {path}")
        total += info.st_size
        if total > max_bytes:
            raise RuntimeError(f"upload files are larger than {max_bytes / (1024 * 1024):g} MB in total")
        resolved.append(full)
    return resolved


def upload(client: CdpClient, session_id: str, ref: str, files: list[str]) -> None:
    # Hand the files to the input directly: no native file chooser is opened.
    result = client.call(
        "Runtime.evaluate",
        {
            "expression": page_call("fileInput", ref, len(files)),
            "contextId": client.context_id,
            "returnByValue": False,
        },
        session_id=session_id,
    )
    if result.get("exceptionDetails"):
        details = result["exceptionDetails"]
        raise RuntimeError(
            (details.get("exception") or {}).get("description")
            or details.get("text")
            or "upload failed"
        )
    object_id = (result.get("result") or {}).get("objectId")
    if not object_id:
        raise RuntimeError("upload target unavailable")
    try:
        client.call("DOM.setFileInputFiles", {"files": files, "objectId": object_id},
                    session_id=session_id)
    finally:
        client.call("Runtime.releaseObject", {"objectId": object_id}, session_id=session_id)


SETTLE_SECONDS = 3.0


def wait_for_settle(client: CdpClient, session_id: str) -> bool:
    """Wait until the page has loaded and made no requests for 500 ms (Chromium's networkIdle).

    Many sites draw a signed-out shell first and replace it once their own requests return,
    so a page captured earlier can show "Sign in" to an account that is signed in.
    """
    deadline = time.monotonic() + SETTLE_SECONDS

    def remaining() -> float:
        budget = deadline - time.monotonic()
        if budget <= 0:
            raise TimeoutError("Page settle budget exhausted")
        return budget

    try:
        # Enabling lifecycle events replays the ones the current document has already reached.
        client.call("Page.setLifecycleEventsEnabled", {"enabled": True}, session_id=session_id,
                    timeout_s=remaining())
        while True:
            # Each call also handles the lifecycle events that arrived meanwhile.
            frame = client.call("Page.getFrameTree", session_id=session_id, timeout_s=remaining())
            if ({"load", "networkIdle"} <= client.lifecycle(session_id, frame["frameTree"]["frame"]["id"])
                    and not page_busy(client, session_id, remaining())):
                return True
            if time.monotonic() >= deadline:
                return False
            time.sleep(min(0.1, remaining()))
    except TimeoutError:
        # A browser too slow to answer within the wait is not settled either.
        return False


def page_busy(client: CdpClient, session_id: str, timeout_s: float) -> bool:
    """Whether the page still shows loading placeholders: a visible aria-busy region or skeleton box."""
    try:
        return eval_json(client, session_id, page_call("busy"), timeout_s) is True
    except RuntimeError:
        # A document without the helper yet: install it and look once more.
        with contextlib.suppress(Exception):
            ensure_helpers(client, session_id)
            return eval_json(client, session_id, page_call("busy"), timeout_s) is True
        return False


def key_event(char: str) -> dict[str, Any] | None:
    """CDP keyDown parameters for one printable ASCII character, or None to insert it as text."""
    if char == "\n":
        # Shift+Enter breaks the line; many chat boxes send their message on a plain Enter.
        return {"key": "Enter", "code": "Enter", "text": "\r", "windowsVirtualKeyCode": 13, "modifiers": 8}
    if len(char) != 1 or not " " <= char <= "~":
        return None
    if char.isdigit():
        return {"key": char, "code": f"Digit{char}", "text": char, "windowsVirtualKeyCode": ord(char)}
    if char.isalpha():
        return {"key": char, "code": f"Key{char.upper()}", "text": char,
                "windowsVirtualKeyCode": ord(char.upper())}
    if char == " ":
        return {"key": " ", "code": "Space", "text": " ", "windowsVirtualKeyCode": 32}
    return {"key": char, "text": char}


def press_key(client: CdpClient, session_id: str, event: dict[str, Any]) -> None:
    # A key that types nothing (Tab, Escape, a shortcut) is a raw key press, as on a real keyboard.
    down = {"type": "keyDown" if "text" in event else "rawKeyDown", **event}
    if "text" in event:
        down["unmodifiedText"] = event["text"]
    client.call("Input.dispatchKeyEvent", down, session_id=session_id)
    client.call("Input.dispatchKeyEvent", {"type": "keyUp", **{k: v for k, v in event.items() if k != "text"}},
                session_id=session_id)


KEY_MODIFIERS = {"alt": 1, "control": 2, "ctrl": 2, "meta": 4, "cmd": 4, "shift": 8}
# The named keys press takes: key, code, Windows key code, and the text it types without modifiers.
NAMED_KEYS: dict[str, tuple[str, str, int, str | None]] = {
    "enter": ("Enter", "Enter", 13, "\r"),
    "tab": ("Tab", "Tab", 9, None),
    "escape": ("Escape", "Escape", 27, None),
    "esc": ("Escape", "Escape", 27, None),
    "backspace": ("Backspace", "Backspace", 8, None),
    "delete": ("Delete", "Delete", 46, None),
    "space": (" ", "Space", 32, " "),
    "arrowup": ("ArrowUp", "ArrowUp", 38, None),
    "arrowdown": ("ArrowDown", "ArrowDown", 40, None),
    "arrowleft": ("ArrowLeft", "ArrowLeft", 37, None),
    "arrowright": ("ArrowRight", "ArrowRight", 39, None),
    "home": ("Home", "Home", 36, None),
    "end": ("End", "End", 35, None),
    "pageup": ("PageUp", "PageUp", 33, None),
    "pagedown": ("PageDown", "PageDown", 34, None),
}
KEY_HELP = "press needs a key such as Enter, Tab, Escape, Backspace, ArrowDown, Shift+Tab or Control+A"


def key_combo(value: Any) -> dict[str, Any]:
    """CDP key event fields for one key with optional modifiers, such as Enter, Shift+Tab or Control+A."""
    if not isinstance(value, str) or not 0 < len(value) <= 40:
        raise RuntimeError(KEY_HELP)
    *names, name = [part.strip() for part in value.split("+")]
    modifiers = 0
    for modifier in names:
        bit = KEY_MODIFIERS.get(modifier.lower(), 0)
        if not bit or modifiers & bit:
            raise RuntimeError(KEY_HELP)
        modifiers |= bit
    named = NAMED_KEYS.get(name.lower())
    if named:
        key, code, key_code, text = named
    elif len(name) == 1 and name.isascii() and name.isalnum():
        key = name.upper() if modifiers & 8 else name.lower()
        code = f"Digit{name}" if name.isdigit() else f"Key{name.upper()}"
        key_code, text = ord(name.upper()), key
    else:
        raise RuntimeError(KEY_HELP)
    event: dict[str, Any] = {"key": key, "code": code, "windowsVirtualKeyCode": key_code}
    if modifiers:
        event["modifiers"] = modifiers
    # Shortcuts with Control, Alt or Meta type no character, as on a real keyboard.
    if text is not None and not modifiers & 7:
        event["text"] = text
    return event


class TypingStopped(RuntimeError):
    """Typing ended before the last key. The message never repeats any of the text."""


def focus_holds(client: CdpClient, session_id: str) -> bool | None:
    """Whether keys still reach the field or its code boxes; None once its document is gone."""
    try:
        return eval_json(client, session_id, page_call("focusHolds")) is True
    except Exception:  # noqa: BLE001
        return None


def page_mark(client: CdpClient, session_id: str) -> tuple[dict[str, Any], int]:
    """The main frame and its navigation count, taken before a type step touches the page."""
    frame = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]
    return frame, client.navigations(session_id, frame["id"])


def type_keys(client: CdpClient, session_id: str, text: str, multiline: bool,
              mark: tuple[dict[str, Any], int]) -> bool:
    """Press each character as a real key into whatever element has focus at that moment.

    Before each key, the page must still be the document of mark, with focus in the field or in a
    box of its code. The check also reads the browser's navigation events, which a page reports
    before the evaluation's answer, so a page that navigates on a key, or while its field was being
    emptied, gets no further keys.
    Returns whether the page moved to another document on the last key, as auto-submitting codes do.
    Either way, the next document has replaced the old one before this returns, when it loads in time.
    """
    frame, navigations = mark
    frame_id = frame["id"]

    def moved_on(holds: bool | None) -> bool:
        if holds is not None and client.navigations(session_id, frame_id) == navigations:
            return False
        wait_for_new_document(client, session_id, frame.get("loaderId"))
        return True

    # Enter in a one-line field would submit its form.
    chars = [char for char in text.replace("\r\n", "\n").replace("\r", "\n") if multiline or char != "\n"]
    index = 0
    try:
        for index, char in enumerate(chars):
            holds = focus_holds(client, session_id)
            if moved_on(holds):
                raise TypingStopped(f"The page changed while typing, after {index} of {len(chars)} characters, "
                                    "so the rest was not typed. Take a fresh snapshot before continuing.")
            if not holds:
                raise TypingStopped(f"Focus left the field while typing, after {index} of {len(chars)} characters, "
                                    "so the rest was not typed. Check the page in this snapshot before trying again.")
            event = key_event(char)
            if event is None:
                client.call("Input.insertText", {"text": char}, session_id=session_id)
            else:
                press_key(client, session_id, event)
        index = len(chars)
        return moved_on(focus_holds(client, session_id))
    except DialogOpened as opened:
        # The dialog stopped the keys; say how many reached the page.
        raise DialogOpened(opened.dialog, typed=index, of=len(chars)) from None


def wait_for_new_document(client: CdpClient, session_id: str, loader_id: Any) -> None:
    """Give a page that began loading another document the settle budget to replace the old one."""
    deadline = time.monotonic() + SETTLE_SECONDS
    while time.monotonic() < deadline:
        try:
            frame = client.call("Page.getFrameTree", session_id=session_id, timeout_s=SETTLE_SECONDS)
            if frame["frameTree"]["frame"].get("loaderId") != loader_id:
                return
        except Exception:  # noqa: BLE001
            return
        time.sleep(0.05)


def typed_in_full(client: CdpClient, session_id: str, ref: str, text: str) -> bool:
    """A widget may refuse keys. A page that submitted or navigated on the last key counts as done."""
    try:
        return eval_json(client, session_id, page_call("typed", ref, text)) is not False
    except Exception:  # noqa: BLE001
        return True


# A long page is read in parts of 12,000 characters and 80 controls; EVAL_HELPERS keeps as many.
SNAPSHOT_PARTS = 25


def snapshot(client: CdpClient, session_id: str, part: int = 0) -> dict[str, Any]:
    # A later part reads what the first one captured, so only the first part waits for the page.
    settled = part > 0 or wait_for_settle(client, session_id)
    ensure_helpers(client, session_id)
    data = eval_json(client, session_id, page_call("snapshot", part) if part else page_call("snapshot"))
    if not isinstance(data, dict):
        raise RuntimeError("snapshot returned non-object")
    return {"ok": True, **data, **({} if settled else {"loading": True})}


def snapshot_or(client: CdpClient, session_id: str, fallback: dict[str, Any]) -> dict[str, Any]:
    """The page after a stopped step, for the result; fallback when it cannot be read."""
    try:
        return snapshot(client, session_id)
    except Exception:  # noqa: BLE001
        return fallback


MAX_ACTIONS = 24
ACT_KINDS = ("click", "fill", "type", "upload", "press", "scroll", "hover", "wait", "dialog")
# Steps that work on one element a snapshot named; press and scroll may name one too.
REF_KINDS = ("click", "fill", "type", "upload", "hover")
SCROLL_DIRECTIONS = ("up", "down", "left", "right")
WAIT_CONDITIONS = ("text", "gone", "url", "quiet")
WAIT_TEXT_LIMIT = 500
WAIT_DEFAULT_SECONDS = 10.0
WAIT_MAX_SECONDS = 15.0
# The waits of one call share this time. It keeps a call inside the supervisor's deadline, and the
# display lock short for other conversations on the same computer.
WAIT_BATCH_SECONDS = 15.0
WAIT_POLL_SECONDS = 0.2


def validate_actions(actions: Any, done_before: int = 0) -> None:
    """Check every step before acting, so a bad step cannot leave a half-done form."""
    if not isinstance(actions, list) or not 1 <= len(actions) + done_before <= MAX_ACTIONS:
        raise RuntimeError(f"Expected 1 to {MAX_ACTIONS} actions")
    for step in actions:
        if not isinstance(step, dict) or step.get("kind") not in ACT_KINDS:
            raise RuntimeError("Invalid browser action")
        kind, ref = step["kind"], step.get("ref")
        if (kind in REF_KINDS or ref is not None) and (not isinstance(ref, str) or not ref):
            raise RuntimeError("Element ref is required")
        if kind == "upload":
            # Check every file before acting, so a bad path cannot leave a half-done form.
            step["files"] = resolve_upload_paths(step.get("paths"), roots=step.get("roots"))
        elif kind in ("fill", "type") and not isinstance(step.get("text"), str):
            raise RuntimeError("Text is required")
        elif kind == "press":
            key_combo(step.get("key"))
        elif kind == "scroll" and step.get("direction") not in (*SCROLL_DIRECTIONS, *((None,) if ref else ())):
            raise RuntimeError("scroll needs a ref, a direction (up, down, left or right), or both")
        elif kind == "wait":
            validate_wait(step)
        elif kind == "dialog" and (not isinstance(step.get("accept"), bool)
                                   or not isinstance(step.get("text", ""), str)):
            raise RuntimeError("A dialog step needs accept: true or false")
        if step.get("origin") is not None and (kind != "fill" or not isinstance(step["origin"], str)):
            raise RuntimeError("An origin applies only to fill")


def validate_wait(step: dict[str, Any]) -> None:
    until, text, timeout = step.get("until"), step.get("text"), step.get("timeout")
    if until not in WAIT_CONDITIONS:
        raise RuntimeError("wait needs until: text, gone, url or quiet")
    if text is not None and (not isinstance(text, str) or not 0 < len(text) <= WAIT_TEXT_LIMIT):
        raise RuntimeError(f"wait text must be 1 to {WAIT_TEXT_LIMIT} characters")
    if until in ("text", "gone") and text is None:
        raise RuntimeError(f"wait until {until} needs text")
    if timeout is not None and (isinstance(timeout, bool) or not isinstance(timeout, (int, float))
                                or not 0 < timeout <= WAIT_MAX_SECONDS):
        raise RuntimeError(f"wait timeout must be more than 0 and at most {WAIT_MAX_SECONDS:g} seconds")


def page_url(client: CdpClient, session_id: str, timeout_s: float = SETTLE_SECONDS) -> str:
    """The tab's address with its fragment, as the browser knows it, also while a document loads."""
    try:
        frame = client.call("Page.getFrameTree", session_id=session_id, timeout_s=timeout_s)["frameTree"]["frame"]
    except Exception:  # noqa: BLE001
        return ""
    return str(frame.get("url") or "") + str(frame.get("urlFragment") or "")


def left_document(client: CdpClient, session_id: str, mark: tuple[dict[str, Any], int]) -> bool:
    """Whether the page began loading another document since mark, as a pressed Enter can make it do.

    When it did, the new document gets the settle budget to replace the old one before this returns.
    """
    frame, navigations = mark
    # A round trip delivers the navigation events the key caused.
    with contextlib.suppress(Exception):
        client.call("Page.getFrameTree", session_id=session_id, timeout_s=SETTLE_SECONDS)
    if client.navigations(session_id, frame["id"]) == navigations:
        return False
    wait_for_new_document(client, session_id, frame.get("loaderId"))
    return True


def wait_state(client: CdpClient, session_id: str, until: str, text: Any, timeout_s: float) -> bool:
    try:
        return eval_json(client, session_id, page_call("waitState", until, text), timeout_s) is True
    except TimeoutError:
        return False
    except RuntimeError:
        # A new document has no helper yet: install it and look again on the next round.
        with contextlib.suppress(Exception):
            ensure_helpers(client, session_id)
        return False


def wait_until(client: CdpClient, session_id: str, step: dict[str, Any], start_url: str, seconds: float) -> bool:
    """Poll the page until the wait step's condition holds; False once its time is up."""
    until, text = step["until"], step.get("text")
    deadline = time.monotonic() + seconds
    while True:
        budget = max(0.2, deadline - time.monotonic())
        if until == "url":
            url = page_url(client, session_id, budget)
            # Without an earlier address to compare with, the first one read is the start.
            start_url = start_url or url
            if url and (text.lower() in url.lower() if text else url != start_url):
                return True
        elif wait_state(client, session_id, until, text, budget):
            return True
        left = deadline - time.monotonic()
        if left <= 0:
            return False
        time.sleep(min(WAIT_POLL_SECONDS, left))


def wait_failure(step: dict[str, Any], requested: float, given: float) -> str:
    until, text = step["until"], step.get("text")
    shared = f" Waits in one browser_act share {WAIT_BATCH_SECONDS:g} seconds."
    if given <= 0:
        return f"This wait had no time left.{shared}"
    if until == "text":
        what = f'"{text}" did not appear'
    elif until == "gone":
        what = f'"{text}" was still on the page'
    elif until == "url":
        what = f'The address did not change to one containing "{text}"' if text else "The address did not change"
    else:
        what = "The page was still loading or changing"
    return (f"{what} after {given:.3g} seconds.{shared if given < requested else ''}"
            " Check the page in this snapshot before trying again.")


def act(client: CdpClient, session_id: str, actions: list[dict[str, Any]], done_before: int = 0) -> dict[str, Any]:
    """Run browser_act steps; done_before counts steps of the call that already ran (an answered dialog)."""
    validate_actions(actions, done_before)
    ensure_helpers(client, session_id)
    total = done_before + len(actions)
    completed = done_before
    uncertain = False
    # Refs belong to the document they were read from; a page that moved on keeps none of them.
    page_changed = False
    wait_left = WAIT_BATCH_SECONDS
    # A wait for the address to change compares with the address before the first step.
    start_url = page_url(client, session_id) if any(
        step["kind"] == "wait" and step["until"] == "url" for step in actions) else ""
    kind: str | None = None
    try:
        for step in actions:
            kind, ref = step["kind"], step.get("ref")
            if page_changed and isinstance(ref, str):
                # The result shows the page the step led to, so the bot can carry on from there.
                return {"uncertain": False, **snapshot_or(client, session_id, {"uncertain": True}), "ok": False,
                        "completed": completed, "error": "Stale element ref. Take a fresh snapshot."}
            if page_changed:
                # Steps without a ref carry on in the new document.
                ensure_helpers(client, session_id)
            if kind == "dialog":
                raise Refused("No dialog from your steps is open on this page, so there is nothing to answer.")
            if kind == "wait":
                requested = float(step.get("timeout") or WAIT_DEFAULT_SECONDS)
                given = min(requested, wait_left)
                started = time.monotonic()
                met = given > 0 and wait_until(client, session_id, step, start_url, given)
                wait_left = max(0.0, wait_left - (time.monotonic() - started))
                if not met:
                    return {"uncertain": False, **snapshot_or(client, session_id, {}), "ok": False,
                            "completed": completed, "error": wait_failure(step, requested, given)}
                completed += 1
                continue
            # Preflight catches stale refs before a mutation is dispatched.
            if isinstance(ref, str) and not eval_json(client, session_id, f"Boolean({page_call('resolve', ref)})"):
                raise RuntimeError("Stale element ref. Take a fresh snapshot.")
            if kind == "press":
                event = key_combo(step["key"])
                if isinstance(ref, str) and eval_json(client, session_id, page_call("focusRef", ref)) is not True:
                    raise Refused("The element did not take keyboard focus, so no key was pressed. "
                                  "Click it, then press the key again.")
                mark = page_mark(client, session_id)
                uncertain = True
                press_key(client, session_id, event)
                completed += 1
                uncertain = False
                page_changed = left_document(client, session_id, mark) or page_changed
                continue
            if kind == "scroll":
                uncertain = True
                eval_json(client, session_id, page_call("scroll", ref, step.get("direction")))
                completed += 1
                uncertain = False
                continue
            if kind == "hover":
                point = eval_json(client, session_id, page_call("hoverPoint", ref))
                if not isinstance(point, dict) or not all(
                        isinstance(point.get(axis), (int, float)) for axis in ("x", "y")):
                    raise RuntimeError("The element has no point to hover over")
                uncertain = True
                # A real pointer move, so the page sees :hover and its mouse events as from a person.
                client.call("Input.dispatchMouseEvent", {"type": "mouseMoved", "x": point["x"], "y": point["y"],
                                                         "button": "none", "buttons": 0}, session_id=session_id)
                completed += 1
                uncertain = False
                continue
            if kind == "upload":
                uncertain = True
                upload(client, session_id, ref, step["files"])
                completed += 1
                uncertain = False
                continue
            if kind == "type":
                uncertain = True
                mark = page_mark(client, session_id)
                # One character goes into the ref'd box alone; longer text replaces the whole code.
                focus = eval_json(client, session_id, page_call("focusForKeys", ref, len(step["text"]) > 1))
                if isinstance(focus, dict) and focus.get("select"):
                    kind = "fill"
                else:
                    if not isinstance(focus, dict) or not focus.get("focused"):
                        raise RuntimeError("The field did not take keyboard focus. Click it, then type again.")
                    try:
                        page_changed = type_keys(client, session_id, step["text"],
                                                 multiline=bool(focus.get("multiline")), mark=mark)
                    except TypingStopped as stopped:
                        return {"uncertain": False, **snapshot_or(client, session_id, {"uncertain": True}),
                                "ok": False, "completed": completed, "error": str(stopped)}
                    completed += 1
                    uncertain = False
                    if not page_changed and not typed_in_full(client, session_id, ref, step["text"]):
                        return {"uncertain": False, **snapshot(client, session_id), "ok": False, "completed": completed,
                                "error": "The page did not keep every character typed. "
                                         "Check the field in this snapshot before trying again."}
                    continue
            arguments: list[Any] = [ref] if kind == "click" else [ref, step["text"]]
            if step.get("origin"):
                arguments += [step["origin"], step.get("field")]
            uncertain = True
            data = eval_json(client, session_id, page_call(kind, *arguments))
            if not isinstance(data, dict):
                raise RuntimeError("Action response unavailable")
            completed += 1
            uncertain = False
        kind = None
        snap = snapshot(client, session_id)
        return {**snap, "completed": completed}
    except DialogOpened as opened:
        name = dialog_name(opened.dialog)
        later = total
        if kind == "type" and uncertain and not (opened.typed is not None and opened.typed == opened.of):
            error = (f"The page opened {name} while step {completed + 1} was typing, after {opened.typed} of "
                     f"{opened.of} characters, so the rest was not typed." if opened.typed is not None
                     else f"The page opened {name} before step {completed + 1} typed anything.")
            later -= 1  # That step is told about above; count only the steps after it.
        elif uncertain:
            # The step reached the page before the dialog paused it.
            completed += 1
            error = f"Step {completed} ({kind}) opened {name}."
        else:
            error = f"The page opened {name}."
        return dialog_result(client, session_id, opened.dialog, error, completed, later)
    except Refused as exc:
        # Settled, and fixable in the page browser: no desktop fallback.
        return {"ok": False, "completed": completed, "uncertain": False, "error": str(exc)}
    except Exception as exc:
        return {"ok": False, "completed": completed, "uncertain": uncertain,
                "error": str(exc), "fallback": "computer_act"}


# Live view of one conversation's tab for the person taking over. The viewer page talks to this
# server through the screen gateway's byte stream, so every message is length-prefixed:
# server -> viewer: !I length, !B kind, payload (1 = !H header length, JSON header, JPEG; 2 = JSON)
# viewer -> server: !I length, JSON input event
TAB_STREAM_FRAME = 1
TAB_STREAM_STATUS = 2
TAB_STREAM_MAX_INPUT = 64 * 1024
TAB_STREAM_SCREENCAST = {"format": "jpeg", "quality": 60, "maxWidth": 1280, "maxHeight": 800, "everyNthFrame": 1}
TAB_STREAM_BUTTONS = ("none", "left", "middle", "right")
TARGET_ID = re.compile(r"[a-fA-F0-9]{32}")


def tab_stream_message(kind: int, payload: bytes) -> bytes:
    return struct.pack("!IB", len(payload) + 1, kind) + payload


def _bounded_int(value: Any, low: int, high: int, default: int = 0) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or not low <= value <= high:
        return default
    return value


def _fraction(value: Any) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)) or value != value:
        raise ValueError("Invalid pointer position")
    return min(1.0, max(0.0, float(value)))


def _short_text(value: Any, limit: int) -> str:
    return value if isinstance(value, str) and len(value) <= limit else ""


def tab_input_command(message: Any, viewport: tuple[float, float]) -> tuple[str, dict[str, Any]] | None:
    """Translate one viewer event into a CDP call for the shown tab; anything unexpected is dropped."""
    if not isinstance(message, dict):
        return None
    width, height = viewport
    kind = message.get("t")
    try:
        if kind in ("mouse", "wheel"):
            if width <= 0 or height <= 0:
                return None
            point = {"x": _fraction(message.get("x")) * width, "y": _fraction(message.get("y")) * height,
                     "modifiers": _bounded_int(message.get("modifiers"), 0, 15)}
            if kind == "wheel":
                delta = lambda name: max(-10_000.0, min(10_000.0, float(message.get(name) or 0)))  # noqa: E731
                return "Input.dispatchMouseEvent", {**point, "type": "mouseWheel",
                                                    "deltaX": delta("dx"), "deltaY": delta("dy")}
            event = message.get("type")
            button = message.get("button", "none")
            if event not in ("mousePressed", "mouseReleased", "mouseMoved") or button not in TAB_STREAM_BUTTONS:
                return None
            return "Input.dispatchMouseEvent", {**point, "type": event, "button": button,
                                                "buttons": _bounded_int(message.get("buttons"), 0, 7),
                                                "clickCount": _bounded_int(message.get("clickCount"), 0, 3)}
    except (TypeError, ValueError):
        return None
    if kind == "key":
        event = message.get("type")
        if event not in ("keyDown", "keyUp"):
            return None
        text = _short_text(message.get("text"), 4) if event == "keyDown" else ""
        params: dict[str, Any] = {
            "type": "keyUp" if event == "keyUp" else ("keyDown" if text else "rawKeyDown"),
            "key": _short_text(message.get("key"), 32),
            "code": _short_text(message.get("code"), 32),
            "windowsVirtualKeyCode": _bounded_int(message.get("keyCode"), 0, 255),
            "nativeVirtualKeyCode": _bounded_int(message.get("keyCode"), 0, 255),
            "modifiers": _bounded_int(message.get("modifiers"), 0, 15),
        }
        if text:
            params["text"] = params["unmodifiedText"] = text
        return "Input.dispatchKeyEvent", params
    if kind == "text":
        text = _short_text(message.get("text"), 32_000)
        return ("Input.insertText", {"text": text}) if text else None
    if kind == "nav":
        action = message.get("action")
        if action == "reload":
            return "Page.reload", {}
        if action in ("back", "forward"):
            return "Runtime.evaluate", {"expression": f"history.{action}()"}
    return None


class TabStream:
    """Screencast one conversation tab, following popups it opens, and replay the viewer's input."""

    def __init__(self, client: CdpClient, base_target: str, viewer: socket.socket) -> None:
        self.client = client
        self.viewer = viewer
        self.base = base_target
        self.popups: list[str] = []
        self.target: str | None = None
        self.session: str | None = None
        self.viewport = (0.0, 0.0)
        self._send_lock = threading.Lock()
        self._emit_lock = threading.Lock()
        self._callbacks: dict[int, Any] = {}
        self._next_id = 1_000_000

    def send(self, method: str, params: dict[str, Any] | None = None, *,
             session: str | None = None, callback: Any = None) -> None:
        with self._send_lock:
            msg_id = self._next_id
            self._next_id += 1
            if callback is not None:
                self._callbacks[msg_id] = callback
            payload: dict[str, Any] = {"id": msg_id, "method": method, "params": params or {}}
            if session:
                payload["sessionId"] = session
            self.client._send_frame(json.dumps(payload).encode("utf-8"))

    def emit(self, kind: int, payload: bytes) -> None:
        with self._emit_lock:
            self.viewer.sendall(tab_stream_message(kind, payload))

    def status(self, **fields: Any) -> None:
        self.emit(TAB_STREAM_STATUS, json.dumps(fields).encode("utf-8"))

    def show(self, target: str) -> None:
        previous = self.session

        def attached(message: dict[str, Any]) -> None:
            session = (message.get("result") or {}).get("sessionId")
            if not isinstance(session, str):
                self.status(type="error", reason="attach")
                return
            if previous:
                self.send("Page.stopScreencast", session=previous)
                self.send("Target.detachFromTarget", {"sessionId": previous})
            self.target, self.session = target, session
            self.viewport = (0.0, 0.0)
            self.send("Page.enable", session=session)
            self.send("Page.startScreencast", TAB_STREAM_SCREENCAST, session=session)
            self.status(type="tab", popup=target != self.base)

        self.send("Target.activateTarget", {"targetId": target})
        self.send("Target.attachToTarget", {"targetId": target, "flatten": True}, callback=attached)

    def handle(self, message: dict[str, Any]) -> bool:
        """Apply one CDP message; False once the conversation's tab is gone."""
        if "id" in message:
            callback = self._callbacks.pop(message["id"], None)
            if callback is not None:
                callback(message)
            return True
        method = message.get("method")
        params = message.get("params") or {}
        if method == "Page.screencastFrame":
            if message.get("sessionId") != self.session:
                return True
            meta = params.get("metadata") or {}
            width, height = float(meta.get("deviceWidth") or 0), float(meta.get("deviceHeight") or 0)
            self.viewport = (width, height)
            header = json.dumps({"w": width, "h": height}).encode("utf-8")
            self.emit(TAB_STREAM_FRAME, struct.pack("!H", len(header)) + header
                      + base64.b64decode(params.get("data") or ""))
            # Acknowledge only after the viewer took the frame, so a slow link slows the screencast.
            self.send("Page.screencastFrameAck", {"sessionId": params.get("sessionId")}, session=self.session)
        elif method == "Target.targetCreated":
            info = params.get("targetInfo") or {}
            created = info.get("targetId")
            if (info.get("type") == "page" and isinstance(created, str) and TARGET_ID.fullmatch(created)
                    and info.get("openerId") in (self.base, *self.popups) and created not in self.popups):
                self.popups.append(created)
                self.show(created)
        elif method == "Target.targetDestroyed":
            gone = params.get("targetId")
            if gone == self.base:
                self.status(type="closed")
                return False
            if gone in self.popups:
                self.popups.remove(gone)
                if gone == self.target:
                    self.show(self.popups[-1] if self.popups else self.base)
        elif method == "Target.targetInfoChanged":
            info = params.get("targetInfo") or {}
            if info.get("targetId") == self.target:
                self.status(type="page", url=str(info.get("url") or "")[:2048],
                            title=str(info.get("title") or "")[:300])
        return True

    def pump(self) -> None:
        while True:
            message = json.loads(self.client._read_frame().decode("utf-8"))
            if isinstance(message, dict) and not self.handle(message):
                return

    def read_input(self) -> None:
        try:
            while True:
                length = struct.unpack("!I", _recv_exact(self.viewer, 4))[0]
                if not 0 < length <= TAB_STREAM_MAX_INPUT:
                    return
                command = tab_input_command(json.loads(_recv_exact(self.viewer, length).decode("utf-8")),
                                            self.viewport)
                if command is not None and self.session:
                    self.send(command[0], command[1], session=self.session)
        except (OSError, ValueError, RuntimeError):
            return
        finally:
            # Ending the CDP connection stops the pump and the screencast with it.
            self.client.close()


def _recv_exact(sock: socket.socket, size: int) -> bytes:
    data = bytearray()
    while len(data) < size:
        chunk = sock.recv(size - len(data))
        if not chunk:
            raise RuntimeError("viewer closed")
        data += chunk
    return bytes(data)


def serve_tab_viewer(viewer: socket.socket, key: str, port: int) -> None:
    client: CdpClient | None = None
    try:
        wait_for_cdp(port)
        client = CdpClient(discover_ws_url(port))
        client.connect()
        target = scoped_target(client, scope_directory(port) / key, create=False)
        if target is None:
            viewer.sendall(tab_stream_message(TAB_STREAM_STATUS, b'{"type":"closed"}'))
            return
        assert client._sock is not None
        client._sock.settimeout(None)
        stream = TabStream(client, target, viewer)
        stream.show(target)
        # Popups the tab opens (sign-in windows) are followed while the person is in control.
        stream.send("Target.setDiscoverTargets", {"discover": True})
        threading.Thread(target=stream.read_input, daemon=True).start()
        stream.pump()
    except Exception:  # noqa: BLE001 - the viewer reports a closed stream; nothing else to tell
        pass
    finally:
        if client is not None:
            client.close()
        try:
            viewer.close()
        except OSError:
            pass


def serve_tab_stream(socket_path: str, key: str) -> int:
    # The supervisor places the socket in the shared screen socket directory under /tmp.
    if (not re.fullmatch(r"[a-f0-9]{64}", key) or not socket_path.startswith("/tmp/")
            or os.path.basename(os.path.dirname(socket_path)) != "sockets"
            or not re.fullmatch(r"tab-\d+-[A-Za-z0-9_-]+", os.path.basename(socket_path))):
        print("invalid tab stream arguments", file=sys.stderr)
        return 2
    port = cdp_port()
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        os.unlink(socket_path)
    except FileNotFoundError:
        pass
    server.bind(socket_path)
    server.listen(4)
    current: list[socket.socket] = []
    while True:
        viewer, _ = server.accept()
        # One person views the tab at a time; a reopened view replaces the older one.
        for older in current:
            try:
                older.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
        current[:] = [viewer]
        threading.Thread(target=serve_tab_viewer, args=(viewer, key, port), daemon=True).start()


def exit_when_stdin_closes() -> None:
    """The supervisor owns this pipe; losing it cancels this helper, not Chromium."""
    try:
        while os.read(0, 1024):
            pass
    finally:
        os._exit(130)


def read_stdin_line() -> str:
    """Read one line from fd 0 unbuffered, leaving the rest of stdin for the EOF watcher."""
    data = bytearray()
    while len(data) < 1_048_576:
        chunk = os.read(0, 1)
        if not chunk or chunk == b"\n":
            break
        data += chunk
    return data.decode("utf-8")


def run(argv: list[str]) -> int:
    if len(argv) == 4 and argv[1] == "tab-stream":
        return serve_tab_stream(argv[2], argv[3])
    if len(argv) == 3 and argv[1] == "hold-dialog" and argv[2].isdigit():
        return keep_dialog(int(argv[2]))
    stdin_args = (
        read_stdin_line() if os.environ.get("RAKAZO_BROWSER_ARGS_STDIN") == "1" else None
    )
    if os.environ.get("RAKAZO_BROWSER_WATCH_STDIN") == "1":
        threading.Thread(target=exit_when_stdin_closes, daemon=True).start()
    if len(argv) < 2:
        print(
            json.dumps(
                {
                    "ok": False,
                    "error": "usage: rakazo-page-browser <command> [json-args]",
                    "fallback": "computer_act",
                }
            )
        )
        return 2
    command = argv[1]
    scoped = command.startswith("scoped-")
    command = command.removeprefix("scoped-")
    if command not in ("navigate", "snapshot", "act", "focus", "capabilities") or (command == "focus" and not scoped):
        print(json.dumps({"ok": False, "error": "Unknown browser command.", "fallback": "computer_act"}))
        return 2
    if command == "capabilities":
        # Answered without the browser: what this image's helper can do.
        print(json.dumps({"ok": True, "features": list(FEATURES)}))
        return 0
    args: dict[str, Any] = {}
    raw_args = stdin_args if stdin_args is not None else (argv[2] if len(argv) >= 3 else "")
    if raw_args.strip():
        args = json.loads(raw_args)
    port = cdp_port()
    try:
        wait_for_cdp(port)
        ws_url = discover_ws_url(port)
        client = CdpClient(ws_url)
        client.connect()
        try:
            if scoped:
                result = run_scoped(client, port, command, args)
            else:
                result = run_page_command(client, attach_page(client), command, args)
                # Without a conversation there is no keeper, so a dialog waits for a person.
                if "dialog" in result:
                    settle_dialog(result, held=False)
            print(json.dumps(result))
            return 0  # Structured failures preserve partial action progress.
        finally:
            client.close()
    except DialogOpened as opened:
        print(json.dumps(settle_dialog({"ok": False, "uncertain": False, "dialog": opened.dialog,
                                        "error": f"The page opened {dialog_name(opened.dialog)}."}, held=False)))
        return 0
    except PageNotResponding:
        print(json.dumps(not_responding(command, 0)))
        return 0
    except Exception as exc:  # noqa: BLE001
        print(json.dumps({"ok": False, "error": str(exc), "fallback": "computer_act",
                              "uncertain": command == "act"}))
        return 0


if __name__ == "__main__":
    sys.exit(run(sys.argv))
