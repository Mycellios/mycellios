  rootArtifactId String   @unique
  artifactId     String
  spaceId        String
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  root           Artifact @relation("ArtifactShareRoot", fields: [rootArtifactId], references: [id], onDelete: Cascade)
  artifact       Artifact @relation("ArtifactSharePinned", fields: [artifactId], references: [id], onDelete: Cascade)
  @@index([spaceId, userId])
  @@index([artifactId])
  @@map("artifact_shares")
}

model UsageRecord {
  id                 String   @id @default(cuid())
  spaceId            String
  /// Which bot spent this. Deliberately NOT a relation: a usage row is spend that really
  /// happened, and no lifecycle event on the bot may delete it or blank its attribution.
  /// `Cascade` erased the row; `SetNull` would erase the attribution instead, and because
  /// deleting a bot also deletes its runs, `runId` goes null in the same breath — the row
  /// would keep only space, user, model and token counts.
  ///
  /// So the id outlives the bot and may dangle. Read it with a LEFT JOIN; `BotDeletion.id`
  /// IS the bot id, so a deleted bot's name is still reachable for display.
  botId              String?
  userId             String
  /// The Space member whose turn this was; `userId` (the Mico's owner) paid for it.
  requestedByUserId  String?
  runId              String?
  provider           String
  model              String
  /// Uncached input; cache buckets are additional, reasoning is a subset of output.
  inputTokens        Int?
  outputTokens       Int?
  cacheReadTokens    Int?
  cacheWriteTokens   Int?
  cacheWrite1hTokens Int?
  reasoningTokens    Int?
  totalTokens        Int?
  costUsd            Float?
  providerRequestId  String?
  currency           String   @default("usd")
  auditRevision      Int      @default(0)
  costSource         String?
  pricingVersion     String?
  pricingSnapshot    Json?
  usageSource        String?
  callId             String?  @unique
  operationId        String?
  operationKind      String   @default("answer")
  /// Durable attribution, deliberately without lifecycle foreign keys.
  parentRunId        String?
  agentId            String?
  createdAt          DateTime @default(now())

  @@index([spaceId, userId, createdAt])
  @@index([userId])
  @@map("usage_records")
}

