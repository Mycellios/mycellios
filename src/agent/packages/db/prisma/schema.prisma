  @@index([spaceId, userId, archivedAt, pinned, updatedAt])
  @@index([sectionId])
  @@index([leadBotId])
  @@map("chat_groups")
}

/// A Mico's message_bot request, or a send_to_group brief, that waits for answers from other
/// Micos. Ids and states only: what was said stays in the (encrypted) messages.
model BotMessageRequest {
  id               String    @id @default(cuid())
  spaceId          String
  space            Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId           String
  senderBotId      String
  senderBot        Bot       @relation("BotMessageRequestSender", fields: [senderBotId], references: [id], onDelete: Cascade)
  /// The sender's main chat: answers land there and the resume turn runs there.
  senderThreadId   String
  senderThread     Thread    @relation("BotMessageRequestThread", fields: [senderThreadId], references: [id], onDelete: Cascade)
  /// The turn that sent it.
  senderRunId      String?
  /// A send_to_group request: the group the work runs in.
  groupId          String?
  /// The one turn that hands every answer back to the sender once all recipients settled.
  resumeRunId      String?   @unique
  settledAt        DateTime?
  /// "Hide this list" on the settled request.
  hiddenAt         DateTime?
  createdAt        DateTime  @default(now())
  recipients       BotMessageRecipient[]

  @@index([senderThreadId, createdAt])
  @@index([spaceId, userId])
  @@map("bot_message_requests")
}

/// One recipient of a BotMessageRequest and the turn that answers it.
model BotMessageRecipient {
  id              String            @id @default(cuid())
  requestId       String
  request         BotMessageRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  spaceId         String
  userId          String
  botId           String
  bot             Bot               @relation("BotMessageRecipientBot", fields: [botId], references: [id], onDelete: Cascade)
  /// Its turn for this request, in its own chat or (send_to_group) in the group.
  runId           String?           @unique
  run             Run?              @relation("BotMessageRecipientRun", fields: [runId], references: [id], onDelete: SetNull)
  /// asked, replied, failed or stopped.
  state           String            @default("asked")
  /// The answer as delivered into the sender's chat.
  answerMessageId String?
  settledAt       DateTime?
  createdAt       DateTime          @default(now())

  @@unique([requestId, botId])
  @@index([state, createdAt])
  @@map("bot_message_recipients")
}

model ChatGroupMember {
  id        String    @id @default(cuid())
  groupId   String
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: NoAction)
  createdAt DateTime  @default(now())

  @@unique([groupId, botId])
  @@index([botId])
  @@map("chat_group_members")
}

/// A folder on the owner's PC that the group's members on that PC may use in the group's turns
/// (specs/group-shared-folders/spec.md). Opaque id and display name only: the native path stays
/// on the PC that granted it.
model ChatGroupFolder {
  id        String    @id @default(cuid())
  groupId   String
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  spaceId   String
  userId    String
  /// HMAC the granting PC derived from its own credential, the scope, the group and the path.
  folderId  String
  name      String
  /// Mount name under group/, assigned once and unique in the group (case-insensitively).
  label     String
  createdAt DateTime  @default(now())

  @@unique([groupId, folderId])
  @@unique([groupId, label])
  @@index([spaceId, userId])
  @@map("chat_group_folders")
}

model DevelopmentProject {
  id String @id
  spaceId String
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId, userId])
  @@map("development_projects")
}

model Thread {
  botMessageRequests BotMessageRequest[] @relation("BotMessageRequestThread")
  taskMemories MemoryDocument[] @relation("TaskMemory")
  localMemoryReviews LocalMemoryReview[] @relation("ReviewThread")
  messagePins MessagePin[]
  hostedWebAgent HostedWebAgent?
  inboxTask InboxTask?
  taskBotId String?
  taskBot Bot? @relation("MicoTaskThreads", fields: [taskBotId], references: [id], onDelete: Cascade)
  projectKey String?
  taskKey String?
  title String?
  /// Conversation lifecycle; the main chat, groups and external chats keep these null.
  /// Archive lives here (task_inbox.archivedAt is only a mirror kept for rollback).
  archivedAt DateTime?
  /// auto (first message), agent or user. A user title is never replaced automatically.
  titleSource String?
  /// user, agent, routine, branch or delegation; labels only, never access.
  startedBy String?
  startedByRunId String?
  startedByRun Run? @relation("ThreadStartedByRun", fields: [startedByRunId], references: [id], onDelete: SetNull)
  /// How the last finished turn ended: completed, failed or interrupted.
  outcome String?
  /// The last turn's failure, at most 2000 characters; the next turn clears it.
  lastError String?
  /// A pending delete: hidden until then, recoverable before it, removed by the worker after it.
  deleteAfter DateTime?
  branchedFromThreadId String?
  branchedFromThread Thread? @relation("ThreadBranches", fields: [branchedFromThreadId], references: [id], onDelete: SetNull)
  branches Thread[] @relation("ThreadBranches")
  branchedFromMessageId String?
  branchedFromMessage Message? @relation("ThreadBranchSource", fields: [branchedFromMessageId], references: [id], onDelete: SetNull)
  /// A Space member's own conversation with a Mico shared with them (specs/space-members). The
  /// thread stays the Mico owner's; no foreign key, so it keeps its author after they leave.
  memberUserId String?
  id                          String     @id @default(cuid())
  spaceId                     String
  space                       Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                       String?    @unique
  bot                         Bot?       @relation(fields: [botId], references: [id], onDelete: Cascade)
  groupId                     String?    @unique
  group                       ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  externalConversationId      String?    @unique
  externalConversation        ExternalConversation? @relation(fields: [externalConversationId], references: [id], onDelete: Cascade)
  userId                      String
  createdAt                   DateTime   @default(now())
  nextEventSeq                Int        @default(0)
  nextMessageSeq              Int        @default(0)
  /// First message the agent may read; earlier messages remain visible to the user.
  contextStartSeq            Int        @default(0)
  agentContextReset          Json?
  historyCompactedUpToSeq     Int?
  historyCompactionSummary    String?    @db.Text
  historyCompactionGeneration Int        @default(0)
  unread                      Boolean    @default(false)
  /// Highest message seq the user has read; the "New" divider goes after it. -1 = none read.
  lastReadSeq                 Int        @default(-1)
  messages                    Message[]
  events                      Event[]
  tasks                       Task[]
  runs                        Run[]
  routines                    Routine[]

  @@index([spaceId])
  @@unique([spaceId, userId, taskKey])
  @@index([taskBotId, projectKey])
  @@index([taskBotId, archivedAt])
  @@index([deleteAfter])
  @@index([startedByRunId])
  @@index([branchedFromThreadId])
  @@index([branchedFromMessageId])
  @@index([spaceId, memberUserId])
  @@unique([id,spaceId,userId],map:"memory_thread_identity_scope_key")
  @@map("threads")
}

model MessagePin {
  messageId String
  threadId String
  spaceId String
  userId String
  pinnedAt DateTime @default(now())
  /// Set when the person's own Mico pinned it in its conversation; NULL is the person's pin.
  pinnedByBotId String?
  pinnedByBot Bot? @relation("MessagePinAuthor",fields:[pinnedByBotId],references:[id],onDelete:Cascade)
  message Message @relation(fields:[messageId,threadId],references:[id,threadId],onDelete:Cascade)
  thread Thread @relation(fields:[threadId,spaceId,userId],references:[id,spaceId,userId],onDelete:Cascade,onUpdate:NoAction)
  space Space @relation(fields:[spaceId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  @@id([messageId,userId])
  @@index([spaceId,userId,threadId,pinnedAt])
  @@index([spaceId,userId,pinnedAt])
  @@index([pinnedByBotId])
  @@map("message_pins")
}

model Message {
  pins MessagePin[]
  branchThreads Thread[] @relation("ThreadBranchSource")
  id               String    @id @default(cuid())
  threadId         String
  thread           Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  seq              Int
  role             String
  blocks           Json
  botId            String?
  replyToMessageId String?
  replyQuote       String?
  replyTo          Message?  @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[] @relation("MessageReplies")
  runId            String?
  clientNonce      String?
  /// The Space member who wrote a user message in their conversation; null for the owner.
  authorUserId     String?
  /// sha256 of the sign-in session that sent an owner message; its shared Chrome tabs reach that turn.
  browserSessionKey String?
  /// Blind-index search tokens for the encrypted blocks; NULL until the row is encrypted.
  searchTokens     Int[]
  sourceRuns            Run[]             @relation("RunSourceMessage")
  externalTranscriptFor  ExternalMessage?
  steeringMessages SteeringMessage[]
  createdAt        DateTime  @default(now())

  @@unique([threadId, seq])
  @@unique([id, threadId])
  @@unique([threadId, clientNonce])
  @@index([threadId, seq])
  @@index([replyToMessageId])
  @@index([runId, seq])
  @@index([searchTokens], type: Gin)
  @@map("messages")
}

model Event {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  botId     String
  seq       Int
  type      String
  payload   Json
  runId     String?
  createdAt DateTime @default(now())

  @@unique([threadId, seq])
  @@index([spaceId, createdAt])
  @@index([threadId, seq])
  @@index([runId, type, seq])
  @@map("events")
}

model Task {
  workPlan Json?
  parentTaskId String?
  workParent Task? @relation("WorkTree", fields: [parentTaskId], references: [id], onDelete: Cascade)
  workChildren Task[] @relation("WorkTree")
  delegationRootId String?
  delegationKey String? @unique
  delegationState String?
  delegationRevision Int @default(0)
  delegatedRunId String?
  expectedResult String?
  resources String[] @default([])
  dependencies String[] @default([])
  returnRunId String?
  returnedToParentAt DateTime?
  delegationCheckedAt DateTime?
  workStopPending Boolean @default(false)
  workStopTargets Json?
  assignmentVersion Int @default(1)
  paused Boolean @default(false)
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  prompt    String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      Run[]

  @@index([spaceId, botId])
  @@index([spaceId, userId, delegationState])
  @@index([parentTaskId])
  @@map("tasks")
}

model Run {
  botMessageRecipient BotMessageRecipient? @relation("BotMessageRecipientRun")
  id                   String            @id @default(cuid())
  spaceId              String
  space                Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                String
  bot                  Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  threadId             String
  thread               Thread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  startedThreads       Thread[]          @relation("ThreadStartedByRun")
  /// An offline turn stays with its own server workspace across retries.
  cloudComputerId      String?
  cloudComputer        Computer?         @relation("CloudComputerRuns", fields: [cloudComputerId], references: [id], onDelete: SetNull)
  taskId               String
  task                 Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId               String
  /// The Space member whose message started this turn; the Mico's owner (`userId`) pays.
  requestedByUserId    String?
  status               String
  trigger              String
  modelProvider        String?
  modelId              String?
  thinkingLevel        String?
  // True when these columns are the model the run must keep. A later attempt
  // may record the model it used in the same columns without setting this.
  modelPinned          Boolean           @default(false)
  desktopToolCreditLimitMicros Int?
    /// Runtime and payer selected before a conversational turn first calls a model. No secrets.
    modelExecution       Json?
  error                String?
  leaseOwner           String?
  leaseFence           Int               @default(0)
  leaseExpiresAt       DateTime?
  checkpoint           String?
  clientNonce          String?
  sourceMessageId      String?
  sourceMessage        Message?          @relation("RunSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  routineId            String?
  routine              Routine?          @relation(fields: [routineId], references: [id], onDelete: SetNull)
  // The failed routine run this run retries. Unique, so a run is retried at most once.
  retryOfRunId         String?           @unique
  // Durable retry schedule; null means runnable immediately when queued.
  wakeAt               DateTime?
  /// A routine run that finished with nothing new: it posted nothing and notified nobody.
  quiet                Boolean           @default(false)
  /// Scheduled routine runs that did not happen and were folded into this one.
  missedRuns           Int               @default(0)
  /// Why they did not happen: offline (the server was not running) or busy (an earlier
  /// run had not started yet). Checked by runs_missed_reason_check.
  missedReason         String?
  // Server-side first visible output, preserved across attempts and resumes.
  firstResponseAt      DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  botOutcomeReturnedAt DateTime?
  messagingMirroredAt  DateTime?
  teamChatMirroredAt   DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  attempts             Attempt[]
  effects              ExternalEffect[]
  steeringMessages     SteeringMessage[]
  externalMessage      ExternalMessage?
  /// Which local memory notes this run put in its prompt (ids only).
  memoryRecall         RunMemoryRecall?

  @@unique([spaceId, clientNonce])
  @@index([status, wakeAt])
  @@index([status, leaseExpiresAt])
  @@index([status, updatedAt, id])
  @@index([botOutcomeReturnedAt, status])
  @@index([trigger, status, messagingMirroredAt, updatedAt])
  @@index([trigger, status, teamChatMirroredAt, updatedAt])
  @@index([spaceId, botId])
  @@index([botId])
  @@index([taskId])
  @@index([sourceMessageId])
  @@index([threadId, status, createdAt])
  @@index([cloudComputerId, status])
  @@index([routineId])
  @@map("runs")
}

model SteeringMessage {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  runId     String?
  run       Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// Set when a pending row must resume as this trigger so its reply can be delivered.
  originTrigger String?
  /// Model agreed for an inbound delivery that had to wait. Empty follows the bot.
  modelProvider String?
  modelId       String?
  thinkingLevel String?
  claimedAt DateTime?
  createdAt DateTime @default(now())
  /// Order of a queued_user row in its conversation's queue (lowest first). New rows take the
  /// message's seq; a reorder reuses the queue's own positions; Send now goes before the first.
  position  Int?
  /// An edit in progress: the editing client's hold id. A held first row stops the queue from
  /// sending until the edit is saved or cancelled; a hold never expires on its own.
  heldBy    String?
  heldAt    DateTime?
  /// The unsaved text of that edit (sealed with the Space key like message content).
  editDraft String?

  @@unique([messageId, botId])
  @@index([botId, runId, createdAt])
  @@index([runId])
  @@map("steering_messages")
}

model Attempt {
  id         String    @id @default(cuid())
  runId      String
