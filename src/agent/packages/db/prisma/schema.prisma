  name          String
  description   String            @default("")
  transport     String
  endpoint      String?
  command       String?
  args          Json              @default("[]")
  env           Json              @default("{}")
  files         Json              @default("{}")
  headers       Json              @default("{}")
  secretId      String?
  secret        Secret?           @relation(fields: [secretId], references: [id], onDelete: SetNull)
  enabled       Boolean           @default(true)
  revision      Int               @default(1)
  /// Last launch/discovery outcome: unknown | installing | ok | error.
  healthStatus    String          @default("unknown")
  healthMessage   String?
  healthToolCount Int?
  healthCheckedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  assignments   BotMcpServer[]
  oauthSessions McpOAuthSession[]
  memoryConnection MemoryConnection?

  @@unique([spaceId, userId, slug])
  @@index([spaceId, userId])
  @@map("mcp_servers")
}

/// A personal memory server (specs/mcp-memory). Transport and OAuth stay on its McpServer
/// row, which is hidden from the generic MCP list and from Mico tool assignments.
model MemoryConnection {
  id           String    @id @default(cuid())
  spaceId      String
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId     String    @unique
  server       McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  toolMapping  Json      @default("{}")
  /// unchecked | authorization_required | compatible | incompatible | unreachable
  status       String    @default("unchecked")
  message      String?
  capabilities Json      @default("{}")
  checkedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  grants       MicoMemoryGrant[]

  @@index([spaceId, userId])
  @@map("memory_connections")
}

/// A Mico's access to one personal memory (specs/mcp-memory, phase 2). Nothing is granted
/// by default, and only the connection's owner creates or removes a grant.
/// The local memory notes a run placed in its prompt, so the person can see what a
/// reply had in context. Ids only: note text stays in the encrypted memory tables.
model RunMemoryRecall {
  runId       String   @id
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  spaceId     String
  userId      String
  documentIds String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([spaceId, userId])
  @@map("run_memory_recalls")
}

model MicoMemoryGrant {
  id           String           @id @default(cuid())
  spaceId      String
  space        Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId        String
  bot          Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)
  connectionId String
  connection   MemoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// read or read_write (writing needs the server's write capability).
  access       String           @default("read")
  /// May forget entries; only with read_write.
  allowForget  Boolean          @default(false)
  autoRecall   Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([botId, connectionId])
  @@index([spaceId, userId, botId])
  @@map("mico_memory_grants")
}

model McpOAuthSession {
  id              String    @id
  spaceId         String
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId          String
  serverId        String
  server          McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  endpoint        String
  redirectUri     String
  oauthCiphertext String
  createdAt       DateTime  @default(now())

  @@index([spaceId, userId, createdAt])
  @@map("mcp_oauth_sessions")
}

/// A subscription sign-in waiting for its pasted code, so whichever API process
/// receives the code can finish it. The ciphertext holds the PKCE verifier.
model ModelOAuthSession {
  id         String   @id
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  provider   String
  /// The connection it signs in to; a newer sign-in for the same one replaces it.
  scope      String
  ciphertext String
  createdAt  DateTime @default(now())

  @@index([userId, provider])
  @@index([scope])
  @@index([createdAt])
  @@map("model_oauth_sessions")
}

model BotMcpServer {
  id            String    @id @default(cuid())
  spaceId       String
  space         Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId         String
  bot           Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  serverId      String
  server        McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId        String
  allowAllTools Boolean   @default(true)
  allowedTools  Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([botId, serverId])
  @@index([spaceId, userId, botId])
  @@map("bot_mcp_servers")
}

model MessagingIdentity {
  id                   String    @id @default(cuid())
  provider             String
  /// Sender address within the provider: E.164 number, Slack user id, ….
  address              String
  /// Opaque provider thread id for the 1:1 conversation; learned on inbound.
  dmThreadId           String?
  installationId       String?
  installation         MessagingInstallation? @relation(fields: [installationId], references: [id], onDelete: Cascade)
  userId               String
  spaceId              String
  space                Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                String    @unique
  verifiedAt           DateTime?
  lastInboundAt        DateTime?
  outboundSinceInbound Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([provider, address])
  @@index([userId])
  @@index([installationId])
  @@map("messaging_identities")
}

model MessagingChannel {
  id            String              @id @default(cuid())
  provider      String
  /// Opaque provider thread id of the group conversation.
  threadId      String              @unique
  name          String?
  introPostedAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  members       MessagingChannelMember[]

  @@map("messaging_channels")
}

model MessagingChannelMember {
  id         String      @id @default(cuid())
  channelId  String
  channel    MessagingChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  address    String
  identityId String?
  status     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([channelId, address])
  @@index([identityId])
  @@map("messaging_channel_members")
}

/// Short-lived web-issued code binding a chat address to an existing user+bot.
model MessagingLinkCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  spaceId   String
  botId     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("messaging_link_codes")
}

model MessagingOutbound {
  id              String    @id @default(cuid())
  idempotencyKey  String    @unique
  kind            String
  /// DM rows resolve their thread through the identity at drain time.
  identityId      String?
  /// Group/intro rows post straight to this provider thread id.
  threadId        String?
  body            String
  status          String    @default("pending")
  attempts        Int       @default(0)
  nextAttemptAt   DateTime?
  providerHandle  String?
  sourceMessageId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@map("messaging_outbound")
}

model AgentConnection {
  requestVersion Int      @default(1)
  id             String   @id @default(cuid())
  requesterBotId String
  targetBotId    String
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([requesterBotId, targetBotId])
  @@index([targetBotId, status])
  @@map("agent_connections")
}

model BotSecret {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId      String
  bot        Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  name       String
  origin     String
  auth       Json
  ciphertext String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, spaceId, botId, name])
  @@index([botId])
  @@index([spaceId])
  @@map("bot_secrets")
}

model ExternalConversation {
  id                       String            @id @default(cuid())
  provider                 String
  workspaceId              String
  externalKey              String
  conversationId           String
  displayName              String?
  participantNames         String[]          @default([])
  teamChatAmbientEnabled   Boolean?
  teamChatRules            String?
  automatedSenderPolicies  Json              @default("{}")
  spaceId                  String
  space                    Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                    String
  bot                      Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId                   String
  thread                   Thread?
  messages                 ExternalMessage[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@unique([provider, workspaceId, externalKey])
  @@index([spaceId, botId])
  @@map("external_conversations")
}

model ExternalMessage {
  id                     String                @id @default(cuid())
  externalConversationId String
  externalConversation   ExternalConversation  @relation(fields: [externalConversationId], references: [id], onDelete: Cascade)
  providerEventId        String
  kind                   String                @default("direct")
  senderId               String
  senderName             String
  senderIsBot            Boolean               @default(false)
  content                String
  replyThreadId          String?
  batchContext           String?
  engagementReason       String?
  judgedAt               DateTime?
  status                 String                @default("received")
  runId                  String?               @unique
  run                    Run?                  @relation(fields: [runId], references: [id], onDelete: SetNull)
  threadMessageId        String?               @unique
  threadMessage          Message?              @relation(fields: [threadMessageId], references: [id], onDelete: SetNull)
  attempts               Int                   @default(0)
  nextAttemptAt          DateTime?
  lastError              String?
  providerReplyHandle    String?
  deliveredAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([externalConversationId, providerEventId])
  @@index([status, nextAttemptAt])
  @@index([externalConversationId, senderIsBot, createdAt])
  @@map("external_messages")
}

model AgentSecret {
  id              String   @id @default(cuid())
  spaceId         String
  space           Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  name            String
  secretId        String   @unique
  secret          Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([spaceId, name])
  @@index([spaceId, updatedAt])
  @@map("agent_secrets")
}

// Deployment-owned integration credentials; never exposed through read DTOs.
model IntegrationProviderConfig {
  id         String @id
  ciphertext String
  updatedAt  DateTime @updatedAt

  @@map("integration_provider_configs")
}

model Board {
  id           String   @id @default(cuid())
  spaceId      String   @unique
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name         String   @default("Board")
  ticketPrefix String   @default("RAK")
  nextNumber   Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tickets      Ticket[]

  @@map("boards")
}

model Ticket {
  id              String    @id @default(cuid())
  boardId         String
  board           Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  spaceId         String
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  description     String?
  status          String    @default("todo")
  priority        String?
  assigneeBotId   String?
  assigneeBot     Bot?      @relation("TicketAssigneeBot", fields: [assigneeBotId], references: [id], onDelete: SetNull)
  createdByBotId  String?
  createdByBot    Bot?      @relation("TicketCreatorBot", fields: [createdByBotId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdByUser   User?     @relation("TicketCreatorUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt       DateTime?
  comments        TicketComment[]

  @@unique([boardId, number])
  @@index([spaceId, status])
  @@index([boardId, status])
  @@map("tickets")
}

model TicketComment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorBotId  String?
  authorBot    Bot?     @relation("TicketCommentAuthorBot", fields: [authorBotId], references: [id], onDelete: SetNull)
  authorUserId String?
  authorUser   User?    @relation("TicketCommentAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

/// Wallet projection; financial deltas live in the append-only billing journal.
model ModelCreditAccount {
  organizationId        String             @id
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mode                  String?
  balanceMicros         BigInt             @default(0)
  pendingCreditCheckout Boolean            @default(false)
  entries               ModelCreditEntry[]
  lots                  ModelCreditLot[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@map("model_credit_accounts")
}

/// Current purchase, reservation, or expiry projection. Database triggers journal every change.
model ModelCreditEntry {
  id                     String             @id @default(cuid())
  organizationId         String
  account                ModelCreditAccount @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)
  source                 String             @unique
  amountMicros           BigInt
  pending                Boolean            @default(false)
  desktopTool            Boolean            @default(false)
  callId                 String?            @unique
  userId                 String?
  spaceId                String?
  runId                  String?
  /// The Space member whose turn reserved this hold; counted against their daily allowance.
  requestedByUserId      String?
  provider               String?
  model                  String?
  providerRequestId      String?
  usage                  Json?
  reconciliationState    String?
  reconciliationAttempts Int                @default(0)
  nextReconcileAt        DateTime?
  auditRevision          Int                @default(0)
  allocations            Json?
  /// Sum of allocations; detects settlements by older writers without inferring credit provenance.
  fundedMicros           BigInt?
  createdAt              DateTime           @default(now())

  @@index([reconciliationState, nextReconcileAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, runId, desktopTool])
  @@index([requestedByUserId, createdAt])
  @@map("model_credit_entries")
}

/// Immutable financial journal. Deliberately no lifecycle foreign keys.
model BillingAuditEvent {
  id                String   @id @default(cuid())
  source            String   @unique
  kind              String
  organizationId    String?
  callId            String?
  userId            String?
  spaceId           String?
  provider          String?
  model             String?
  providerRequestId String?
  amountMicros      BigInt   @default(0)
  currency          String   @default("usd")
  details           Json
  createdAt         DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([callId, createdAt])
  @@map("billing_audit_events")
}

/// Grant allocation projection. Used funds include reservations; null expiry means non-expiring.
model ModelCreditLot {
  id              String             @id
  organizationId  String
  account         ModelCreditAccount @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)
  amountMicros    BigInt
  availableMicros BigInt
  usedMicros      BigInt             @default(0)
  expiredMicros   BigInt             @default(0)
  expiresAt       DateTime?
  auditRevision   Int                @default(0)
  createdAt       DateTime           @default(now())

  @@index([organizationId, expiresAt])
  // Partial indexes for outstanding grants are managed in SQL migrations.
  @@map("model_credit_lots")
}

model SpaceModelRoleChoice {
  spaceId       String
  userId        String
  spaceMember   SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  role          String
  position      Int
  provider      String
  modelId       String
  thinkingLevel String?
  credentialId  String?
  credential    UserModelCredential? @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)

  @@id([spaceId, userId, role, position])
  @@index([credentialId, userId])
  @@map("space_model_role_choices")
}

/// Which of a member's account-wide settings a Space replaces with its own. Without a row the
/// Space follows the account: "models" covers every model role, "voice" the voice choices,
/// "confirmations" the approval rules and auto review.
model SpaceSettingOverride {
  spaceId     String
  userId      String
  spaceMember SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  setting     String
  createdAt   DateTime    @default(now())

  @@id([spaceId, userId, setting])
  @@map("space_setting_overrides")
}

/// The member's account-wide models per purpose; position 0 runs, the rest take over in order.
model UserModelRoleChoice {
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String
  position      Int
  provider      String
  modelId       String
  thinkingLevel String?
  credentialId  String?
  credential    UserModelCredential? @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)

  @@id([userId, role, position])
  @@index([credentialId, userId])
  // Unique index user_model_role_choices_model_connection_key (NULLS NOT DISTINCT) is created in SQL.
  @@map("user_model_role_choices")
}

/// A connection's own model and effort, which belong to the connection in every Space.
model UserModelPreference {
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId  String
  credential    UserModelCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  modelId       String?
  thinkingLevel String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@id([userId, credentialId])
  @@map("user_model_preferences")
}

/// The member's account-wide voice per voice connection; one is the default.
model UserVoicePreference {
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String
  credential   UserVoiceCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  voiceId      String              @default("")
  // Fish speech-model override. Null keeps the deployment default.
  speechModel  String?
  isDefault    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@id([userId, credentialId])
  // Partial unique index user_voice_preferences_default_key is created in SQL.
  @@map("user_voice_preferences")
}

/// The member's account-wide action approval rules.
model UserActionApprovalRule {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  effect     String
  matchKind  String
  matchValue String
  createdAt  DateTime @default(now())

  @@unique([userId, effect, matchKind, matchValue])
  @@map("user_action_approval_rules")
}

/// The member's account-wide auto review and skip-approvals choice.
model UserActionAutoReviewPreference {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled       Boolean  @default(false)
  skipApprovals Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("user_action_auto_review_preferences")
}

model MessagingInstallation {
  id String @id @default(cuid())
  provider String
  workspaceId String
  workspaceName String
  spaceId String
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId String
  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)
  ciphertext String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([provider, workspaceId])
  @@index([spaceId, userId])
  identities MessagingIdentity[]
  @@map("messaging_installations")
}

model MessagingInstallSession {
  id String @id
  provider String
  spaceId String
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId String
  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
  @@map("messaging_install_sessions")
}

model InboxTask {
 id String @id
 spaceId String
 space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 botId String
 bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)
 threadId String @unique
 thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
 clientNonce String
 title String
 readSeq Int @default(-1)
 pinned Boolean @default(false)
 remindAt DateTime?
 reminderNotifiedAt DateTime?
 reminderClaimedAt DateTime?
 archivedAt DateTime?
 createdAt DateTime @default(now())
 @@unique([spaceId,userId,clientNonce])
 @@index([spaceId,userId,createdAt], map: "task_inbox_owner_idx")
 @@map("task_inbox")
}

/// Web Push uses narrow system-only raw SQL for session locking and atomic outbox claims.
model WebPushSettings {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings Json @default("{}")
  @@map("web_push_settings")
}
model WebPushPresence {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  clientId String
  focusedUntil DateTime @db.Timestamptz(6)
  @@id([userId, sessionId, clientId])
  @@map("web_push_presence")
}
model WebPushDevice {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  clientId String
  digest String @unique
  ciphertext String
  focusedUntil DateTime? @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  deliveries WebPushDelivery[]
  @@unique([userId, sessionId, clientId])
  @@index([userId], map: "web_push_devices_user")
  @@map("web_push_devices")
}
model WebPushDelivery {
  id String @id
  deviceId String
  device WebPushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  eventKey String
  ciphertext String
  spaceId String
  botId String
  runId String
  kind String
  eventId String
  dueAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  leaseUntil DateTime? @db.Timestamptz(6)
  attempts Int @default(0)
  finishedAt DateTime? @db.Timestamptz(6)
  /// Set when the push service accepted the notice; dismissals go only to these devices.
  sentAt DateTime? @db.Timestamptz(6)
  @@unique([deviceId, eventKey])
  @@map("web_push_deliveries")
}
/// A question or takeover notice that reached a channel; resolved once the run stops waiting on it.
model NotificationRequest {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId String
  botId String
  threadId String
  runId String
  eventId String
  kind String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  resolvedAt DateTime? @db.Timestamptz(6)
  @@unique([runId, eventId])
  @@map("notification_requests")
}

// Durable admission/receipt record: a submitted review is only reconciled, never replayed.
model LocalMemoryReview {
  thread Thread @relation("ReviewThread",fields:[threadId,spaceId,userId],references:[id,spaceId,userId],onDelete:Cascade,onUpdate:NoAction)
  bot Bot @relation("ReviewBot",fields:[botId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  space Space @relation("ReviewSpace",fields:[spaceId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  user User @relation("ReviewUser",fields:[userId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  id String @id
  threadId String
  botId String
  spaceId String
  userId String
  generation Int
  lastSeq Int
  status String
  maximumMicrounits Int @default(0)
  chargedMicrounits Int?
  idempotencyKey String @unique
  connectionDigest String
  result Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([threadId, generation, lastSeq])
  @@index([userId, spaceId, createdAt],map:"review_daily_budget")
  @@map("local_memory_reviews")
}

/// WhatsApp number linked as a device of the owner's Mycellios Desktop
/// (specs/whatsapp-linked-device). The WhatsApp session stays on that PC; the
/// server keeps which Mico answers, who may write and the outbox.
model WhatsAppLink {
  id              String             @id @default(cuid())
  userId          String
  spaceId         String
  space           Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId           String
  bot             Bot                @relation(fields: [botId], references: [id], onDelete: Cascade)
  /// Stable id of the Desktop that holds the session; only it may act on the link.
  desktopDeviceId String
  mode            String
  /// Bare `<digits>@s.whatsapp.net`: one row per number, so re-linking keeps history.
  accountJid      String             @unique
  accountLid      String?
  phone           String
  pushName        String?
  status          String
  /// Groups last reported by Desktop: [{ jid, name }].
  groups          Json               @default("[]")
  lastSeenAt      DateTime?
  removedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  senders         WhatsAppSender[]
  outbound        WhatsAppOutbound[]
  inbound         WhatsAppInbound[]

  @@index([userId, spaceId])
  @@map("whatsapp_links")
}

model WhatsAppSender {
  id        String       @id @default(cuid())
  linkId    String
  link      WhatsAppLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  kind      String
  jid       String
  label     String
  status    String
  /// One-time approval code sent to a pending sender of a dedicated number.
  code      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([linkId, jid])
  @@map("whatsapp_senders")
}

/// One send that Desktop performs once and reports; uncertain sends fail, never replay.
model WhatsAppOutbound {
  id                String       @id @default(cuid())
  linkId            String
  link              WhatsAppLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  idempotencyKey    String       @unique
  chatJid           String
  kind              String
  text              String?
  quotedId          String?
  quotedParticipant String?
  emoji             String?
  targetId          String?
  targetFromMe      Boolean      @default(false)
  targetParticipant String?
  sourceMessageId   String?
  status            String       @default("pending")
  claimedAt         DateTime?
  attempts          Int          @default(0)
  providerHandle    String?
  error             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([linkId, status, createdAt])
  @@map("whatsapp_outbound")
}

/// One uploaded WhatsApp message: idempotency, and where its reply and reactions go.
model WhatsAppInbound {
  id              String       @id @default(cuid())
  linkId          String
  link            WhatsAppLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  waMessageId     String
  chatJid         String
  senderJid       String
  participant     String?
  kind            String
  threadMessageId String?
  runId           String?
  createdAt       DateTime     @default(now())

  @@unique([linkId, waMessageId])
  @@index([runId])
  @@index([threadMessageId])
  @@map("whatsapp_inbound")
}
