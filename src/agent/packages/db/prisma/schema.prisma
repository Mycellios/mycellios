generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HostedWeb {
  agent HostedWebAgent?
  id String @id
  spaceId String
  userId String
  slug String @unique
  title String
  summary String
  draftBundle Json
  version Int @default(1)
  publishedRevisionId String?
  forkedFrom String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  revisions HostedWebRevision[] @relation("WebRevisions")
  publishedRevision HostedWebRevision? @relation("PublishedWeb", fields: [id, publishedRevisionId], references: [siteId, id], onDelete: NoAction, onUpdate: NoAction, map: "hosted_webs_published_revision_fk")
  pins HostedWebPin[]
  views HostedWebView[]
  data HostedWebData[]
  snapshots HostedWebSnapshot[]
  files HostedWebFile[]
  @@index([spaceId, userId])
  @@unique([id, userId, spaceId])
  @@map("hosted_webs")
}

model HostedWebAgent {
  siteId String @id
  userId String
  spaceId String
  botId String
  threadId String @unique
  site HostedWeb @relation(fields: [siteId, userId, spaceId], references: [id, userId, spaceId], onDelete: Cascade, onUpdate: NoAction)
  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([siteId, userId, spaceId])
  @@map("hosted_web_agents")
}

model HostedWebRevision {
  id String @id
  siteId String
  spaceId String
  userId String
  number Int
  digest String
  title String
  summary String
  bundle Json
  createdAt DateTime @default(now())
  site HostedWeb @relation("WebRevisions", fields: [siteId, userId, spaceId], references: [id, userId, spaceId], onDelete: Cascade, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publishedBy HostedWeb[] @relation("PublishedWeb")
  @@unique([siteId, number])
  @@unique([siteId, id])
  @@map("hosted_web_revisions")
}

model HostedWebPin {
  siteId String
  userId String
  spaceId String
  site HostedWeb @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([siteId, userId, spaceId])
  @@map("hosted_web_pins")
}

/// Per-user app data behind the Hifa Store bridge; value is Space-encrypted.
model HostedWebData {
  id String @id
  siteId String
  userId String
  spaceId String
  preview Boolean
  key String
  value Json
  bytes Int
  updatedAt DateTime @default(now()) @updatedAt
  site HostedWeb @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([siteId, userId, spaceId, preview, key])
  @@index([spaceId, userId])
  @@map("hosted_web_data")
}

/// Private draft history; bundle is Space-encrypted and rows are immutable.
model HostedWebSnapshot {
  id String @id
  siteId String
  userId String
  spaceId String
  version Int
  source String
  title String
  summary String
  bundle Json
  digest String
  bytes Int
  createdAt DateTime @default(now())
  site HostedWeb @relation(fields: [siteId, userId, spaceId], references: [id, userId, spaceId], onDelete: Cascade, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([siteId, version])
  @@index([siteId, createdAt])
  @@map("hosted_web_snapshots")
}

/// Per-user app file metadata; the bytes are sealed in the artifact object store.
model HostedWebFile {
  id String @id
  siteId String
  userId String
  spaceId String
  preview Boolean
  name String
  mimeType String
  bytes Int
  sha256 String
  storageKey String
  createdAt DateTime @default(now())
  site HostedWeb @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([siteId, userId, spaceId, preview, name])
  @@index([spaceId, userId])
  @@map("hosted_web_files")
}

/// Sealed objects still to remove after their file rows were deleted.
model HostedWebFileTombstone {
  storageKey String @id
  spaceId String
  userId String
  createdAt DateTime @default(now())
  @@map("hosted_web_file_tombstones")
}

model HostedWebView {
  siteId String
  day String
  visitor String
  createdAt DateTime @default(now())
  site HostedWeb @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([siteId, day, visitor])
  @@index([createdAt])
  @@map("hosted_web_views")
}

model AiDataConsent {
  userId String
  spaceId String
  recipientKey String
  version String
  grantedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceMember SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)

  @@id([userId, spaceId, recipientKey])
  @@map("ai_data_consents")
}

model User {
  localMemoryReviews LocalMemoryReview[] @relation("ReviewUser")
  messagePins MessagePin[]
  hostedWebs HostedWeb[]
  hostedWebRevisions HostedWebRevision[]
  hostedWebPins HostedWebPin[]
  hostedWebData HostedWebData[]
  hostedWebSnapshots HostedWebSnapshot[]
  hostedWebFiles HostedWebFile[]
  inboxTasks InboxTask[]
  workflows Workflow[]
  workflowExecutions WorkflowExecution[]
  aiDataConsents AiDataConsent[]
  id                          String                       @id
  name                        String
  email                       String
  emailVerified               Boolean                      @default(false)
  image                       String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  avatarStyle                 String                       @default("organic")
  micoDefaults                Json                         @default("{}")
  micoSettingsVersion         Int                          @default(0)
  /// IANA timezone such as "Pacific/Auckland". Null until set; bots then get UTC only.
  timezone                    String?
  sessions                    Session[]
  accounts                    Account[]
  passkeys                    Passkey[]
  members                     Member[]
  invitations                 Invitation[]
  spaceInvitations            SpaceInvitation[]            @relation("SpaceInvitationInviter")
  modelCredentials            UserModelCredential[]
  voiceCredentials            UserVoiceCredential[]
  secrets                     Secret[]
  tailnetConnections          TailnetConnection[]
  mcpServers                  McpServer[]
  memoryConnections           MemoryConnection[]
  micoMemoryGrants            MicoMemoryGrant[]
  botSections                 BotSection[]
  developmentProjects         DevelopmentProject[]
  actionApprovalRules         ActionApprovalRule[]
  actionAutoReviewPreferences ActionAutoReviewPreference[]
  modelRoleChoices            UserModelRoleChoice[]
  modelPreferences            UserModelPreference[]
  voicePreferences            UserVoicePreference[]
  approvalRules               UserActionApprovalRule[]
  autoReviewPreference        UserActionAutoReviewPreference?
  createdSpaces               Space[]                      @relation("SpaceCreator")
  botSecrets BotSecret[]
  agentSecrets               AgentSecret[]
  createdTickets              Ticket[]                     @relation("TicketCreatorUser")
  ticketComments              TicketComment[]              @relation("TicketCommentAuthorUser")
  pushToken                   PushToken?
  mobilePushDevices           MobilePushDevice[]
  signupSurvey                SignupSurvey?
  computerRuns                ComputerRun[]

  @@unique([email])
  @@map("user")
  messagingInstallations MessagingInstallation[]
  messagingInstallSessions MessagingInstallSession[]
  webPushSettings WebPushSettings?
  webPushDevices WebPushDevice[]
  webPushPresence WebPushPresence[]
  notificationRequests NotificationRequest[]
}

/// A row with no answers means the user skipped the survey.
model SignupSurvey {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  use       String?
  teamSize  String?
  source    String?
  createdAt DateTime @default(now())

  @@map("signup_surveys")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

/// One current device registration per account, matching the notification API contract.
/// No session FK: password changes delete a session before the replacement is created.
model PushToken {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ciphertext String
  tokenDigest String @unique
  sessionId String
  updatedAt DateTime @updatedAt

  @@map("push_tokens")
}

/// Additive per-device registrations; PushToken remains readable by older releases.
model MobilePushDevice {
  tokenDigest String @id
  transport String @default("expo")
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ciphertext String
  sessionId String
  updatedAt DateTime @updatedAt

  @@index([userId, sessionId])
  @@map("mobile_push_devices")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// One place taken from the deployment's invitation link (SIGNUP_INVITE_CODE). System-only.
/// No foreign key: the place is claimed while signup may still hold the user row uncommitted,
/// and a deleted account keeps its place so a batch never admits more than its limit.
model SignupInviteRedemption {
  userId    String   @id
  /// SHA-256 of the invitation code, never the code itself.
  inviteId  String
  createdAt DateTime @default(now())

  @@index([inviteId])
  @@map("signup_invite_redemptions")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Better Auth WebAuthn credentials. `publicKey` is the base64 COSE key.
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@unique([credentialID])
  @@index([userId])
  @@map("passkey")
}

/// Better Auth credential rate limits. `lastRequest` is epoch milliseconds.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Organization {
  id           String              @id
  name         String
  slug         String
  logo         String?
  createdAt    DateTime
  metadata     String?
  members      Member[]
  invitations  Invitation[]
  spaces       Space[]
  billing      BillingAccount?
  modelCredits ModelCreditAccount?

  @@unique([slug])
  @@map("organization")
}

model BillingAccount {
  organizationId      String       @id
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId          String       @unique
  creditAmountCents   Int?
  subscriptionId      String?
  subscriptionItemId  String?
  priceId             String?
  status              String?
  seats               Int?
  trialEndsAt         DateTime?
  currentPeriodEndsAt DateTime?
  cancelAtPeriodEnd   Boolean      @default(false)
  endedAt             DateTime?
  subscribedAt        DateTime?
  syncedAt            DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("billing_accounts")
}

model ActionApprovalRule {
  id              String   @id @default(cuid())
  spaceId         String
  space           Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  effect          String
  matchKind       String
  matchValue      String
  createdAt       DateTime @default(now())

  @@unique([spaceId, createdByUserId, effect, matchKind, matchValue])
  @@index([spaceId, createdByUserId])
  @@map("action_approval_rules")
}

model ActionAutoReviewPreference {
  id            String   @id @default(cuid())
  spaceId       String
  space         Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled       Boolean  @default(false)
  skipApprovals Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([spaceId, userId])
  @@map("action_auto_review_preferences")
}

model Member {
  id               String        @id
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String
  createdAt        DateTime
  spaceMemberships SpaceMember[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Space {
  botMessageRequests BotMessageRequest[]
  localMemoryReviews LocalMemoryReview[] @relation("ReviewSpace")
  messagePins MessagePin[]
  hostedWebs HostedWeb[]
  hostedWebRevisions HostedWebRevision[]
  hostedWebPins HostedWebPin[]
  hostedWebData HostedWebData[]
  hostedWebSnapshots HostedWebSnapshot[]
  hostedWebFiles HostedWebFile[]
  inboxTasks InboxTask[]
  workflows Workflow[]
  workflowExecutions WorkflowExecution[]
  aiDataConsents              AiDataConsent[]
  id                          String                       @id
  organizationId              String
  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                        String
  isDefault                   Boolean                      @default(false)
  createdByUserId             String?
  createdByUser               User?                        @relation("SpaceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt                   DateTime                     @default(now())
  deletingAt                  DateTime?
  deletionClaimId             String?
  memberships                 SpaceMember[]
  invitations                 SpaceInvitation[]
  micoShares                  MicoShare[]
  bots                        Bot[]
  botSections                 BotSection[]
  developmentProjects         DevelopmentProject[]
  botDeletions                BotDeletion[]
  threads                     Thread[]
  events                      Event[]
  tasks                       Task[]
  runs                        Run[]
  routines                    Routine[]
  routineDeliveryReceipts      RoutineDeliveryReceipt[]
  scratchpadItems             ScratchpadItem[]
  taughtSkills                TaughtSkill[]
  agentSkills                 AgentSkill[]
  agentImports                AgentImport[]
  connections                 Connection[]
  capabilities                CapabilityInstall[]
  memoryDocuments             MemoryDocument[]
  agentHomes                  AgentHome[]
  browserProfiles             BrowserProfile[]
  artifacts                   Artifact[]
  notificationPreferences     NotificationPreference[]
  computers                   Computer[]
  computerRuns                ComputerRun[]
  externalEffects             ExternalEffect[]
  tailnetConnections          TailnetConnection[]
  tailnetPolicies             TailnetPolicy[]
  mcpServers                  McpServer[]
  memoryConnections           MemoryConnection[]
  micoMemoryGrants            MicoMemoryGrant[]
  mcpOAuthSessions            McpOAuthSession[]
  modelOAuthSessions          ModelOAuthSession[]
  botMcpServers              BotMcpServer[]
  messagingIdentities         MessagingIdentity[]
  whatsAppLinks               WhatsAppLink[]
  actionApprovalRules         ActionApprovalRule[]
  actionAutoReviewPreferences ActionAutoReviewPreference[]
  memoryConfig                SpaceMemoryConfig?
  secrets                     Secret[]
  chatGroups                  ChatGroup[]
  botSecrets                  BotSecret[]
  externalConversations       ExternalConversation[]
  agentSecrets                AgentSecret[]
  board                       Board?
  tickets                     Ticket[]
  ticketComments              TicketComment[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([createdByUserId])
  @@map("spaces")
  messagingInstallations MessagingInstallation[]
  messagingInstallSessions MessagingInstallSession[]
}

/// A space's data encryption key, wrapped by a master key. There is no foreign key:
/// keys are created on their own connection, possibly before the space row commits.
/// A trigger deletes them with the space, which crypto-shreds anything left behind.
model SpaceKey {
  id          String   @id
  spaceId     String
  version     Int
  masterKeyId String
  wrappedKey  String
  createdAt   DateTime @default(now())

  @@unique([spaceId, version])
  @@index([masterKeyId])
  @@map("space_keys")
}

model SpaceMember {
  desktopExecution DesktopExecutionPreference?
  desktopBotDevices DesktopBotDevice[]
  micoShares       MicoShareMember[]
  id               String                 @id
  spaceId          String
  organizationId   String
  space            Space                  @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  userId           String
  member           Member                 @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  role             String                 @default("member")
  createdAt        DateTime
  modelPreferences SpaceModelPreference[]
  voicePreferences SpaceVoicePreference[]
  aiDataConsents AiDataConsent[]
  modelRoleChoices SpaceModelRoleChoice[]
  settingOverrides SpaceSettingOverride[]

  @@unique([spaceId, userId])
  @@index([organizationId, userId])
  @@index([userId, createdAt])
  @@map("space_members")
}

/// A remembered native execution choice, not a bearer or a transport lease.
model DesktopExecutionPreference {
  spaceId String
  userId String
  enabled Boolean @default(true)
  updatedAt DateTime @default(now()) @updatedAt
  membership SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)

  @@id([spaceId, userId])
  @@map("desktop_execution_preferences")
}

/// The PC an owner last chose for a Mico, as a hashed device key. Not a lease or a
/// bearer: it only settles which online PC runs the Mico after restarts.
model DesktopBotDevice {
  spaceId    String
  userId     String
  botId      String
  deviceKey  String
  updatedAt  DateTime    @default(now()) @updatedAt
  membership SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  bot        Bot         @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([spaceId, userId, botId])
  @@index([botId])
  @@map("desktop_bot_devices")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// A one-use invitation to a Space other than Personal (specs/space-members). Only the SHA-256
/// of its link token is stored. An email invitation can only be accepted by that address.
model SpaceInvitation {
  id               String    @id
  spaceId          String
  space            Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  inviterUserId    String
  inviter          User      @relation("SpaceInvitationInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  /// "email" or "link".
  kind             String
  /// Lowercased address of an email invitation; null for a link.
  email            String?
  tokenHash        String    @unique
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  acceptedAt       DateTime?
  /// No foreign key: the record of who joined outlives that account.
  acceptedByUserId String?

  @@index([spaceId, createdAt])
  @@index([inviterUserId, createdAt])
  @@map("space_invitations")
}

/// Who a Mico is shared with (specs/space-members, phase 1b): everyone in its Space, or the
/// people in MicoShareMember. No row is the default, `none`. Sharing gives `chat`: the person
/// talks to the Mico in their own conversations, on its owner's Credits within the allowance.
model MicoShare {
  botId                String            @id
  bot                  Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  spaceId              String
  space                Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  everyone             Boolean           @default(false)
  /// Credit microunits each person may spend on this Mico per UTC day; 0 stops their messages.
  dailyAllowanceMicros BigInt            @default(1000000)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  members              MicoShareMember[]

  @@index([spaceId])
  @@map("mico_shares")
}

/// One person a Mico is shared with. Removing them from the Space removes the row.
model MicoShareMember {
  botId      String
  share      MicoShare   @relation(fields: [botId], references: [botId], onDelete: Cascade)
  spaceId    String
  userId     String
  membership SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@id([botId, userId])
  @@index([spaceId, userId])
  @@map("mico_share_members")
}

model DeploymentSettings {
  modelCreditsEnabled             Boolean  @default(false)
  id                              String   @id @default("default")
  /// Deprecated: retained for rolling-release compatibility; never authorizes app users.
  ownerUserId                     String?
  signupsEnabled                  Boolean  @default(true)
  signupAllowlist                 String   @default("")
  signupPolicyInitialized         Boolean  @default(false)
  defaultModelProvider            String?
  defaultModelId                  String?
  deploymentModelCredentialCipher String?
  computerHost                    String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@map("deployment_settings")
}

/// Append-only security audit trail. No foreign keys, so an account deletion
/// keeps the record of what happened; retention pruning is the only delete.
/// Never stores message content, secrets, or tokens.
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  spaceId   String?
  ip        String?
  userAgent String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([ip, createdAt])
  @@index([userId, createdAt])
  @@map("security_events")
}

model UserModelCredential {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  label       String
  secretId    String
  supportsImages Boolean              @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  preferences SpaceModelPreference[]
  roleChoices SpaceModelRoleChoice[]
  userPreferences UserModelPreference[]
  userRoleChoices UserModelRoleChoice[]

  @@unique([id, userId])
  @@index([userId, provider, updatedAt])
  @@map("user_model_credentials")
}

model UserVoiceCredential {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  secretId    String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  preferences SpaceVoicePreference[]
  userPreferences UserVoicePreference[]

  @@unique([id, userId])
  @@index([userId, provider, updatedAt])
  @@map("user_voice_credentials")
}

model SpaceModelPreference {
  id           String              @id @default(cuid())
  spaceId      String
  userId       String
  spaceMember  SpaceMember         @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  credentialId String
  credential   UserModelCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  modelId      String?
  thinkingLevel String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([spaceId, userId, credentialId])
  @@index([credentialId])
  @@map("space_model_preferences")
}

model SpaceVoicePreference {
  id           String              @id @default(cuid())
  spaceId      String
  userId       String
  spaceMember  SpaceMember         @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
