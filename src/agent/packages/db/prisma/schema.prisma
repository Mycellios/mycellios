  ledGroups ChatGroup[] @relation("ChatGroupLead")
  sentBotMessageRequests BotMessageRequest[] @relation("BotMessageRequestSender")
  botMessageRecipients BotMessageRecipient[] @relation("BotMessageRecipientBot")
  messagePins MessagePin[] @relation("MessagePinAuthor")
  localMemoryReviews LocalMemoryReview[] @relation("ReviewBot")
  hostedWebAgents HostedWebAgent[]
  inboxTasks InboxTask[]
  taskConcurrency Int @default(4)
  agentEngine String @default("pi")
  /// When the one-time move of a This PC Mico to a CLI signed in on its PC happened (never repeats).
  localEngineAdoptedAt DateTime?
  nativeConfig Json?
  busyMessageMode String?
  micoPreferences Json @default("{}")
  skillPins BotSkillPin[]
  screenGeneration Int @default(0)
  id                String            @id @default(cuid())
  spaceId           String
  space             Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId            String
  name              String
  title             String            @default("")
  description       String            @default("")
  instructions      String            @default("")
  selfUpdateInstructions Boolean @default(false)
  instructionHistory Json @default("[]")
  pendingInstructionsRunId String?
  color             String
  notifyOnFinish    Boolean           @default(true)
  pinned            Boolean           @default(false)
  position          Int               @default(0)
  sectionId         String?
  section           BotSection?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  archivedAt        DateTime?
  parentBotId       String?
  spawnKey          String?
  memoryScope       String?
  parent            Bot?              @relation("BotChildren", fields: [parentBotId], references: [id], onDelete: SetNull)
  children          Bot[]             @relation("BotChildren")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  taskThreads       Thread[] @relation("MicoTaskThreads")
  thread            Thread?
  computerId        String?
  computer          Computer?         @relation(fields: [computerId], references: [id], onDelete: SetNull)
  computerSwitching Boolean           @default(false)
  voiceId           String?
  autoSpeak         Boolean           @default(false)
  modelProvider     String?
  modelId           String?
  thinkingLevel     String?
  disabledBuiltinTools String[] @default([])
  webhookSecretId   String?
