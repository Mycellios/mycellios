{
  "name": "@mycellios/api",
  "version": "0.1.0",
  "license": "Apache-2.0 AND LicenseRef-PolyForm-Shield-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-watch.mjs src/index.ts",
    "build": "node ../../scripts/build-server.mjs src/index.ts src/cli/migrate-database.ts src/cli/bootstrap-owner.ts src/cli/shared-storage.ts",
    "start": "node --enable-source-maps dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/api/src",
    "db:migrate": "tsx src/cli/migrate-database.ts",
    "db:deploy": "node --enable-source-maps dist/cli/migrate-database.js",
    "secrets:infisical": "tsx src/cli/secrets-infisical.ts",
    "content-encryption": "tsx src/cli/content-encryption.ts",
    "home-storage": "tsx src/cli/home-storage.ts",
    "shared-storage": "tsx src/cli/shared-storage.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@orpc/server": "1.15.7",
    "@mycellios/adapter-kit": "*",
    "@mycellios/adapters": "*",
    "@mycellios/auth": "*",
    "@mycellios/contracts": "*",
    "@mycellios/core": "*",
    "@mycellios/db": "*",
    "@mycellios/logging": "*",
    "@mycellios/memory": "*",
    "hono": "4.13.14",
    "mermaid": "11.17.2",
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
